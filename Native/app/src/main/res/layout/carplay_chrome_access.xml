<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/carplay_chrome_access_width"
    android:layout_height="@dimen/carplay_chrome_access_height"
    android:layout_gravity="bottom|left"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/carplay_chrome_access_description"
    android:foreground="?android:attr/selectableItemBackgroundBorderless">

    <View
        android:id="@+id/carplayChromeAccessDot"
        android:layout_width="@dimen/carplay_chrome_access_dot_size"
        android:layout_height="@dimen/carplay_chrome_access_dot_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:background="@drawable/carplay_chrome_access_dot" />
</FrameLayout>
