<?xml version="1.0" encoding="utf-8"?>
<!-- Хост сплита: два окна (VirtualDisplay). Отступы (статус-бар + левый родной док) задаются в коде
     по window insets. Ресайз делителем ВРЕМЕННО отключён — делитель только визуальный + двойной тап
     по нему меняет окна местами. -->
<!-- Корень — FrameLayout (а не LinearLayout): поверх панелей во время перетаскивания делителя
     кладётся оверлей-маска. В горизонтальном LinearLayout такой оверлей стал бы ещё одной колонкой
     и расплющил бы сами панели. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splitHostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/splitPanes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/splitPaneLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <SurfaceView
                android:id="@+id/splitSurfaceLeft"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/splitDivider"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="#000000"
            android:paddingVertical="12dp">

            <View
                android:id="@+id/splitHandleGrip"
                android:layout_width="7dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/split_handle_grip" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/splitPaneRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <SurfaceView
                android:id="@+id/splitSurfaceRight"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
