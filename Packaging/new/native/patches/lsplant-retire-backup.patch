+inline void ForgetDeoptimizedBackup(art::ArtMethod *backup) {
+    deoptimized_method_classes_.erase_if(backup, [backup](const auto &owner) {
+        deoptimized_classes_.erase_if(owner.second, [backup](auto &entry) {
+            entry.second.erase(backup);
+            return entry.second.empty();
+        });
+        return true;
+    });
+    deoptimized_methods_set_.erase(backup);
+}
