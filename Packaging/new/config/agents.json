{
  "schema": 2,
  "agents": [
    {
      "id": "acc",
      "target": "com.qinggan.canbus.service",
      "maxAttempts": 4,
      "timeoutSeconds": 35,
      "crashLimit": 3,
      "modules": [
        "acc"
      ]
    },
    {
      "id": "drive-reset",
      "target": "com.qinggan.app.vehiclesetting",
      "maxAttempts": 4,
      "timeoutSeconds": 35,
      "crashLimit": 3,
      "modules": [
        "drive-reset"
      ]
    },
    {
      "id": "vehicle-air",
      "target": "com.qinggan.app.vehicle",
      "maxAttempts": 4,
      "timeoutSeconds": 35,
      "crashLimit": 3,
      "modules": [
        "vehicle-air"
      ]
    },
    {
      "id": "apollo",
      "target": "com.qinggan.app.vehiclesetting",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "condition": "apollo",
      "modules": [
        "apollo"
      ]
    },
    {
      "id": "steering",
      "target": "com.qinggan.keymanager.service",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "modules": [
        "steering"
      ]
    },
    {
      "id": "launcher",
      "target": "com.qinggan.app.launcher",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "modules": [
        "launcher"
      ]
    },
    {
      "id": "windows",
      "target": "system_server",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "modules": [
        "windows"
      ]
    },
    {
      "id": "multidisplay",
      "target": "com.qinggan.systemservice",
      "maxAttempts": 3,
      "timeoutSeconds": 35,
      "modules": [
        "multidisplay"
      ]
    },
    {
      "id": "keyboard-en",
      "target": "com.qinggan.app.qgime",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "condition": "keyboard-en",
      "modules": [
        "keyboard-en"
      ]
    },
    {
      "id": "keyboard-ru",
      "target": "com.qinggan.app.qgime",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "condition": "keyboard-ru",
      "modules": [
        "keyboard-ru"
      ]
    },
    {
      "id": "phone",
      "target": "com.qinggan.bluetoothphone",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "crashLimit": 2,
      "modules": [
        "phone"
      ]
    },
    {
      "id": "cluster",
      "target": "com.qinggan.cluster",
      "maxAttempts": 1,
      "timeoutSeconds": 45,
      "crashLimit": 2,
      "modules": [
        "cluster"
      ]
    },
    {
      "id": "rds",
      "target": "com.pateo.rdsapp",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "crashLimit": 2,
      "modules": [
        "rds",
        "client.com.pateo.rdsapp"
      ]
    },
    {
      "id": "statusbar",
      "target": "com.qinggan.systemui",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "crashLimit": 2,
      "modules": [
        "statusbar",
        "client.com.qinggan.systemui"
      ]
    },
    {
      "id": "yandex-navigation",
      "target": "ru.yandex.yandexnavi",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "crashLimit": 2,
      "modules": [
        "yandex-navigation",
        "client.ru.yandex.yandexnavi"
      ]
    },
    {
      "id": "dgis-navigation",
      "target": "ru.dublgis.dgismobile",
      "maxAttempts": 1,
      "timeoutSeconds": 35,
      "crashLimit": 2,
      "modules": [
        "dgis-navigation",
        "client.ru.dublgis.dgismobile"
      ]
    }
  ]
}
