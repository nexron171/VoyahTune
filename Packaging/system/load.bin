#!/system/bin/sh
# Самодостаточный Frida-оркестратор Open Voyah (не зависит от сторонних обвязок).
# Независимые supervised workers: ожидание одной инъекции не блокирует остальные.
#   1) launcherdock.js       в процессе лаунчера — отрисовка дока сразу после появления лаунчера;
#   2) multidisplay.js       в com.qinggan.systemservice — ранний server whitelist без ожидания других хуков;
#   3) vd_bypass.js          в system_server — trusted VirtualDisplay + инъекция ввода (VD-сплит) + freeform;
#   4) steeringwheelkeys.js  в com.qinggan.keymanager.service — кнопки руля (3090, 173, медиа);
#   5) apollo_tech.js        в com.qinggan.app.vehiclesetting — по сохранённой настройке VoyahTune.
#   6) keyboard_*.js         в com.qinggan.app.qgime — только при явном opt-in из «Другого».
#   7) app_client.js         в выбранных приложениях — client DecorView заполняет место скрытого дока,
#                            а Yandex/Yango MapKit получает renderer scale выбранного per-app DPI.
#
# НАДЁЖНОСТЬ ИНЪЕКЦИИ (важно!):
#   • По умолчанию каждая точная process identity (boot-id + pid + start-time) получает НЕ БОЛЕЕ
#     ОДНОЙ попытки. Attempt-маркер резервируется ДО frida-inject и остаётся при timeout/ошибке.
#   • Единственное узкое исключение — multidisplay: агент имеет idempotence-sentinel, rollback
#     частичного core и точный ready-marker. Для него разрешены максимум три persistent попытки с
#     backoff. Это лечит раннюю загрузку classloader/потерянный stdout, не создавая вечный цикл.
#   • keymanager: тут frida-inject -e иногда ЗАВИСАЕТ (не возвращает управление). Запускаем одну
#     фоновую попытку на PID под timeout; успех подтверждаем только точным ready-маркером агента.

LOG_TAG="vt_load_bin"

logi() { log -p i -t $LOG_TAG "$1"; }
loge() { log -p e -t $LOG_TAG "$1"; }

# Atomic owner lock without a mkdir/pid publication gap and without relying on `flock`
# being present in the target ROM. A new path avoids a takeover race with the legacy
# directory lock: the legacy path is only inspected, never removed before v2 is owned.
LEGACY_LOAD_LOCK=/data/local/tmp/voyah_load.lock
PREVIOUS_V2_LOAD_LOCK=/data/local/tmp/voyah_load.v2.lock
LOAD_LOCK=/data/local/tmp/voyahtune_load.v2.lock

loader_pid_is_live() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$1" 2>/dev/null \
        && tr '\000' ' ' < "/proc/$1/cmdline" 2>/dev/null \
            | grep -q 'local/bin/load.bin'
}

other_loader_pid_is_live() {
    # A persistent PID-only lock may coincidentally point to this process after reboot.
    # Before we publish our own lock, $$ can only mean a stale lock from an earlier boot.
    [ "$1" != "$$" ] && loader_pid_is_live "$1"
}

legacy_load_owner() {
    if [ -d "$LEGACY_LOAD_LOCK" ] && [ ! -L "$LEGACY_LOAD_LOCK" ]; then
        cat "$LEGACY_LOAD_LOCK/pid" 2>/dev/null
    elif [ -L "$LEGACY_LOAD_LOCK" ]; then
        readlink "$LEGACY_LOAD_LOCK" 2>/dev/null
    fi
}

previous_v2_load_owner() {
    if [ -L "$PREVIOUS_V2_LOAD_LOCK" ]; then
        readlink "$PREVIOUS_V2_LOAD_LOCK" 2>/dev/null
    elif [ -f "$PREVIOUS_V2_LOAD_LOCK" ]; then
        cat "$PREVIOUS_V2_LOAD_LOCK" 2>/dev/null
    fi
}

acquire_load_lock() {
    LEGACY_LOAD_OWNER=$(legacy_load_owner)
    other_loader_pid_is_live "$LEGACY_LOAD_OWNER" && exit 0
    PREVIOUS_V2_LOAD_OWNER=$(previous_v2_load_owner)
    other_loader_pid_is_live "$PREVIOUS_V2_LOAD_OWNER" && exit 0

    LOAD_LOCK_ATTEMPTS=0
    LOAD_LOCK_MAX_ATTEMPTS=30
    while [ 1 ]; do
        if ln -s "$$" "$LOAD_LOCK" 2>/dev/null; then
            LOAD_LOCK_OWNER=$$
            break
        fi

        LOAD_LOCK_OWNER=$(readlink "$LOAD_LOCK" 2>/dev/null)
        other_loader_pid_is_live "$LOAD_LOCK_OWNER" && exit 0

        # Remove only the stale owner we inspected; if another loader won the race,
        # its different PID target is left intact.
        if [ -L "$LOAD_LOCK" ]; then
            [ "$(readlink "$LOAD_LOCK" 2>/dev/null)" = "$LOAD_LOCK_OWNER" ] \
                && rm -f "$LOAD_LOCK"
        elif [ -e "$LOAD_LOCK" ]; then
            # Миграция с legacy regular-file lock.
            rm -f "$LOAD_LOCK"
        fi
        LOAD_LOCK_ATTEMPTS=$((LOAD_LOCK_ATTEMPTS + 1))
        if [ "$LOAD_LOCK_ATTEMPTS" -ge "$LOAD_LOCK_MAX_ATTEMPTS" ]; then
            log -p e -t vt_load_bin \
                "owner lock unavailable after ${LOAD_LOCK_ATTEMPTS}s; stop without spinning"
            exit 1
        fi
        sleep 1
    done

    cleanup_load_lock() {
        [ "$(readlink "$LOAD_LOCK" 2>/dev/null)" = "$$" ] && rm -f "$LOAD_LOCK"
    }

    # У trapped signal default termination заменяется handler'ом, поэтому handler обязан вызвать exit.
    trap 'cleanup_load_lock' 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # An old loader could have acquired the legacy directory during an in-place update.
    # Recheck after winning v2; EXIT cleanup releases only our own v2 symlink.
    LEGACY_LOAD_OWNER=$(legacy_load_owner)
    other_loader_pid_is_live "$LEGACY_LOAD_OWNER" && exit 0
    PREVIOUS_V2_LOAD_OWNER=$(previous_v2_load_owner)
    other_loader_pid_is_live "$PREVIOUS_V2_LOAD_OWNER" && exit 0

}

FI=/data/local/bin/frida-inject
HOOK_STATUS_FILE=/data/local/tmp/voyahtune-hook-status.v1
HOOK_STATUS_URI=content://ru.big.town.restoremode.restoremodecontentprovider
HOOK_STATUS_METHOD=publishHookStatusV1
VD=/data/local/bin/vd_bypass.js
SWK=/data/local/bin/steeringwheelkeys.js
LNCH=/data/local/bin/launcherdock.js
MD=/data/local/bin/multidisplay.js
APOLLO=/data/local/bin/apollo_tech.js
KEYBOARD_EN=/data/local/bin/keyboard_lock_en.js
KEYBOARD_RU=/data/local/bin/keyboard_ru.js
VDMARK=/data/local/tmp/voyahtune_vd.pid          # exact identity system_server с vd_bypass
SWK_KM_MARK=/data/local/tmp/voyahtune_swk_km.pid # exact identity keymanager со steeringwheelkeys
SWK_KM_BUSY=/data/local/tmp/voyahtune_swk_km.busy # symlink: targetPid|startUptime|token
VD_ATTEMPT=/data/local/tmp/voyahtune_vd.attempt
SWK_KM_ATTEMPT=/data/local/tmp/voyahtune_swk_km.attempt
LNCH_ATTEMPT=/data/local/tmp/voyahtune_lnch.attempt
MD_ATTEMPT=/data/local/tmp/voyahtune_md.attempt
MD_READY_MARKER='[multidisplay] hook ready v2'
MD_FAILURE_MARKER='[multidisplay] hook failed v2'
MD_MAX_ATTEMPTS=3
MD_RETRY_CORE_SECONDS=2
MD_RETRY_SHORT_SECONDS=20
MD_RETRY_LONG_SECONDS=60
WATCHDOG_CYCLE_SECONDS=1
OPTIONAL_CYCLE_SECONDS=5
WORKER_PREFIX=/data/local/tmp/voyahtune_worker
WORKER_LANES="steering multidisplay launcher vd apollo keyboard apps status"
APOLLO_MARK=/data/local/tmp/voyahtune_apollo.pid
APOLLO_ATTEMPT=/data/local/tmp/voyahtune_apollo.attempt
APOLLO_LOG=/data/local/tmp/voyahtune_apollo.txt
APOLLO_TARGET=com.qinggan.app.vehiclesetting
APOLLO_READY_MARKER='[apollo] hook ready'
APOLLO_RUNTIME_FLAG=/data/user_de/0/ru.big.town.anative/files/apollo_settings_runtime.v1
APOLLO_BOOT_ID_FILE=/proc/sys/kernel/random/boot_id
KEYBOARD_TARGET=com.qinggan.app.qgime
KEYBOARD_SETTING=voyahtune_keyboard_mode
KEYBOARD_MARK=/data/local/tmp/voyahtune_keyboard.pid
KEYBOARD_ATTEMPT=/data/local/tmp/voyahtune_keyboard.attempt
KEYBOARD_LOG=/data/local/tmp/voyahtune_keyboard.txt
KEYBOARD_SEEN_ID=
KEYBOARD_MODE_CURRENT=unknown
APP_CLIENT=/data/local/bin/app_client.js
APP_CLIENT_FULLSCREEN_SETTING=voyahtune_fullscreen_apps
APP_CLIENT_DPI_SETTING=voyahtune_dpi_packages
APP_CLIENT_READY='[app-client] hook ready v1'
MAPKIT_DPI_CLIENT_READY='[mapkit-dpi] hook ready v1'
APP_CLIENT_BUSY=/data/local/tmp/voyahtune_app_client.busy
APP_CLIENT_BUSY_TTL=45
APP_CLIENT_CRASH_WINDOW=45
APP_CLIENT_MAX_RAPID_RESTARTS=2
SWK_KM_BUSY_TTL=45                            # timeout 30s + 5s KILL + запас на cleanup
LNCH_MARK=/data/local/tmp/voyahtune_lnch.pid     # exact process identity лаунчера с launcherdock
MD_MARK=/data/local/tmp/voyahtune_md.pid         # exact process identity systemservice с multidisplay

# Status publication is state-change-only. The local file is the root/ADB source of truth; the
# existing RestoreMode provider receives the same bounded payload so Android 11 app sandboxing does
# not require direct /data/local/tmp access. Provider delivery is bounded after a transient failure.
HOOK_STATUS_LOCAL_PAYLOAD=
HOOK_STATUS_PROVIDER_PAYLOAD=
HOOK_STATUS_PROVIDER_ATTEMPTS=0
HOOK_STATUS_PROVIDER_MAX_ATTEMPTS=3

load_runtime_hook_state() {
    RUNTIME_ID=$1
    RUNTIME_MARK=$2
    RUNTIME_ATTEMPT=$3
    RUNTIME_MARK_VALUE=
    RUNTIME_ATTEMPT_VALUE=
    [ ! -r "$RUNTIME_MARK" ] || IFS= read -r RUNTIME_MARK_VALUE < "$RUNTIME_MARK"
    [ ! -r "$RUNTIME_ATTEMPT" ] || IFS= read -r RUNTIME_ATTEMPT_VALUE < "$RUNTIME_ATTEMPT"
    if [ -z "$RUNTIME_ID" ]; then
        RUNTIME_STATE=waiting
    elif [ "$RUNTIME_MARK_VALUE" = "$RUNTIME_ID" ]; then
        RUNTIME_STATE=active
    elif [ "$RUNTIME_ATTEMPT_VALUE" = "$RUNTIME_ID" ]; then
        RUNTIME_STATE=failed
    else
        RUNTIME_STATE=waiting
    fi
}

publish_hook_status() {
    STATUS_LOADER_STATE=$1
    STATUS_LOADER_PID=${SUPERVISOR_PID:-$$}
    [ "$STATUS_LOADER_STATE" != stopped ] || STATUS_LOADER_PID=0
    STATUS_VD=$VD_STATE
    STATUS_SWK=$SWK_STATE
    STATUS_LNCH=$LNCH_STATE
    STATUS_MD=$MD_STATE
    STATUS_APOLLO=$APOLLO_STATE
    STATUS_KEYBOARD_EN=$KEYBOARD_EN_STATE
    STATUS_KEYBOARD_RU=$KEYBOARD_RU_STATE

    STATUS_SS_PID=${SS:-0}; [ -n "$STATUS_SS_PID" ] || STATUS_SS_PID=0
    STATUS_KMP_PID=${KMP:-0}; [ -n "$STATUS_KMP_PID" ] || STATUS_KMP_PID=0
    STATUS_LP_PID=${LP:-0}; [ -n "$STATUS_LP_PID" ] || STATUS_LP_PID=0
    STATUS_MDP_PID=${MDP:-0}; [ -n "$STATUS_MDP_PID" ] || STATUS_MDP_PID=0
    STATUS_APOLLO_PID=${APOLLO_PID:-0}; [ -n "$STATUS_APOLLO_PID" ] || STATUS_APOLLO_PID=0
    STATUS_KEYBOARD_PID=${KEYBOARD_PID:-0}; [ -n "$STATUS_KEYBOARD_PID" ] || STATUS_KEYBOARD_PID=0

    HOOK_STATUS_PAYLOAD="v=1;loader=$STATUS_LOADER_STATE;pid=$STATUS_LOADER_PID"\
";vd-bypass=$STATUS_VD:$STATUS_SS_PID"\
";steering-wheel=$STATUS_SWK:$STATUS_KMP_PID"\
";launcher-dock=$STATUS_LNCH:$STATUS_LP_PID"\
";multi-display=$STATUS_MD:$STATUS_MDP_PID"\
";apollo-tech=$STATUS_APOLLO:$STATUS_APOLLO_PID"\
";keyboard-en=$STATUS_KEYBOARD_EN:$STATUS_KEYBOARD_PID"\
";keyboard-ru=$STATUS_KEYBOARD_RU:$STATUS_KEYBOARD_PID"

    if [ "$HOOK_STATUS_LOCAL_PAYLOAD" != "$HOOK_STATUS_PAYLOAD" ]; then
        STATUS_STAGE="$HOOK_STATUS_FILE.$$.new"
        if printf '%s\n' "$HOOK_STATUS_PAYLOAD" > "$STATUS_STAGE" \
                && chmod 0644 "$STATUS_STAGE" \
                && mv -f "$STATUS_STAGE" "$HOOK_STATUS_FILE"; then
            HOOK_STATUS_LOCAL_PAYLOAD=$HOOK_STATUS_PAYLOAD
            HOOK_STATUS_PROVIDER_ATTEMPTS=0
        else
            rm -f "$STATUS_STAGE"
            loge "hook status atomic publish failed"
            return
        fi
    fi

    # The loader now starts in late_start, before Android's app/provider phase. Keep local status
    # current immediately, but do not spend the bounded provider retry budget before boot complete.
    STATUS_BOOT_COMPLETED=$(getprop sys.boot_completed 2>/dev/null) || STATUS_BOOT_COMPLETED=
    [ "$STATUS_BOOT_COMPLETED" = 1 ] || return

    if [ "$HOOK_STATUS_PROVIDER_PAYLOAD" != "$HOOK_STATUS_PAYLOAD" ] \
            && [ "$HOOK_STATUS_PROVIDER_ATTEMPTS" -lt "$HOOK_STATUS_PROVIDER_MAX_ATTEMPTS" ]; then
        HOOK_STATUS_PROVIDER_ATTEMPTS=$((HOOK_STATUS_PROVIDER_ATTEMPTS + 1))
        STATUS_CALL_OUTPUT=$(timeout -k 1 4 /system/bin/content call --user 0 \
            --uri "$HOOK_STATUS_URI" --method "$HOOK_STATUS_METHOD" \
            --arg "$HOOK_STATUS_PAYLOAD" 2>&1) || STATUS_CALL_OUTPUT=
        case "$STATUS_CALL_OUTPUT" in
            *'stored=true'*) HOOK_STATUS_PROVIDER_PAYLOAD=$HOOK_STATUS_PAYLOAD ;;
            *)
                if [ "$HOOK_STATUS_PROVIDER_ATTEMPTS" -eq \
                        "$HOOK_STATUS_PROVIDER_MAX_ATTEMPTS" ]; then
                    loge "hook status provider unavailable after bounded retries"
                fi
                ;;
        esac
    fi
}

# Persistent PID-only markers are unsafe on Android: /data/local/tmp survives reboot, while
# zygote can assign the same numeric PID to a fresh process. Bind every returning hook marker to
# boot id + /proc start time so a fresh launcher can never inherit a stale "already injected" mark.
#   $1=pid  $2=expected cmdline
process_identity() {
    ID_PID=$1
    ID_EXPECTED=$2
    case "$ID_PID" in
        ''|*[!0-9]*) return 1 ;;
    esac
    ID_CMDLINE=$(tr '\000' ' ' < "/proc/$ID_PID/cmdline" 2>/dev/null) || return 1
    case "$ID_CMDLINE" in
        "$ID_EXPECTED"|"$ID_EXPECTED "*) ;;
        *) return 1 ;;
    esac
    ID_START=$(awk '{print $22}' "/proc/$ID_PID/stat" 2>/dev/null)
    case "$ID_START" in
        ''|*[!0-9]*) return 1 ;;
    esac
    ID_BOOT=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || return 1
    [ -n "$ID_BOOT" ] || return 1
    kill -0 "$ID_PID" 2>/dev/null || return 1
    # ':' intentionally avoids the '|' delimiter used by the in-memory retry tuple.
    echo "v2:$ID_BOOT:$ID_PID:$ID_START"
}

# Инъекция в цель, которая ВОЗВРАЩАЕТ управление. Маркер пишем ТОЛЬКО при успехе
# и только если после Frida это всё ещё тот же экземпляр процесса.
# Atomic persistent one-shot reservation for an exact process identity.
#   $1=identity  $2=attempt-marker
reserve_injection_attempt() {
    [ "$(cat "$2" 2>/dev/null)" = "$1" ] && return 1
    ATTEMPT_TMP="$2.$$.new"
    if ! printf '%s\n' "$1" > "$ATTEMPT_TMP" || ! mv -f "$ATTEMPT_TMP" "$2"; then
        rm -f "$ATTEMPT_TMP"
        loge "inject attempt marker write FAIL: $2"
        return 1
    fi
    return 0
}

#   $1=pid  $2=script  $3=logfile  $4=success-marker  $5=attempt-marker
#   $6=pre-injection identity  $7=expected cmdline
inject_ret() {
    reserve_injection_attempt "$6" "$5" || return 1
    CURRENT_ID=$(process_identity "$1" "$7" 2>/dev/null) || CURRENT_ID=
    if [ "$CURRENT_ID" != "$6" ]; then
        loge "inject skipped pid=$1 $2 (target identity changed before launch)"
        return 1
    fi
    TRY="$3.try"
    : > "$TRY"
    timeout -k 5 30 "$FI" -p "$1" -s "$2" -e > "$TRY" 2>&1
    RC=$?
    cat "$TRY" >> "$3"
    if [ "$RC" -ne 0 ]; then
        loge "inject FAIL pid=$1 $2 rc=$RC (latched for this process; no retry)"
        return 1
    fi
    # Ошибки самого frida-inject (агент пишет свои сообщения через console.log/Log — их НЕ матчим).
    if grep -qiE 'unable to find|not found|failed to|cannot parse|no such process|error resolving' "$TRY"; then
        loge "inject FAIL pid=$1 $2 (latched for this process; no retry)"
        return 1
    fi
    INJECTED_ID=$(process_identity "$1" "$7") || INJECTED_ID=
    if [ -z "$INJECTED_ID" ] || [ "$INJECTED_ID" != "$6" ]; then
        loge "inject result stale pid=$1 $2 (target identity changed; retry new target)"
        return 1
    fi
    MARK_TMP="$4.$$.new"
    printf '%s\n' "$INJECTED_ID" > "$MARK_TMP" && mv -f "$MARK_TMP" "$4"
    if [ "$?" -ne 0 ]; then
        rm -f "$MARK_TMP"
        loge "inject marker write FAIL pid=$1 $2 (latched for this process; no retry)"
        return 1
    fi
    logi "inject OK pid=$1 $2"
    return 0
}

# VehicleSetting может удержать eternalized Frida session после того, как обвязка timeout завершила
# injector. Поэтому точный ready-marker агента также считается успехом. Попытка всё равно только одна
# на process identity: неисправная прошивка не получает 10-секундный injection loop.
#   $1=pid  $2=exact process identity
inject_apollo() {
    APOLLO_PID="$1"
    APOLLO_ID="$2"
    reserve_injection_attempt "$APOLLO_ID" "$APOLLO_ATTEMPT" || return 1
    APOLLO_CURRENT_ID=$(process_identity "$APOLLO_PID" "$APOLLO_TARGET" 2>/dev/null) \
        || APOLLO_CURRENT_ID=
    if [ "$APOLLO_CURRENT_ID" != "$APOLLO_ID" ]; then
        loge "apollo inject skipped: target identity changed before launch"
        return 1
    fi

    APOLLO_TRY="$APOLLO_LOG.try"
    : > "$APOLLO_TRY"
    timeout -k 5 30 "$FI" -p "$APOLLO_PID" -s "$APOLLO" -e > "$APOLLO_TRY" 2>&1
    APOLLO_RC=$?
    cat "$APOLLO_TRY" >> "$APOLLO_LOG"
    if grep -qiE 'unable to find|not found|failed to|cannot parse|no such process|error resolving' \
            "$APOLLO_TRY"; then
        loge "apollo inject FAIL pid=$APOLLO_PID rc=$APOLLO_RC (latched for this process)"
        return 1
    fi
    if ! grep -qF "$APOLLO_READY_MARKER" "$APOLLO_TRY"; then
        loge "apollo inject FAIL pid=$APOLLO_PID rc=$APOLLO_RC (latched for this process)"
        return 1
    fi

    APOLLO_AFTER_ID=$(process_identity "$APOLLO_PID" "$APOLLO_TARGET" 2>/dev/null) \
        || APOLLO_AFTER_ID=
    if [ "$APOLLO_AFTER_ID" != "$APOLLO_ID" ]; then
        loge "apollo inject result stale pid=$APOLLO_PID"
        return 1
    fi
    APOLLO_MARK_TMP="$APOLLO_MARK.$$.new"
    if ! printf '%s\n' "$APOLLO_ID" > "$APOLLO_MARK_TMP" \
            || ! mv -f "$APOLLO_MARK_TMP" "$APOLLO_MARK"; then
        rm -f "$APOLLO_MARK_TMP"
        loge "apollo marker write FAIL pid=$APOLLO_PID"
        return 1
    fi
    rm -f "$APOLLO_TRY"
    logi "apollo VehicleSetting hook OK pid=$APOLLO_PID profile=persisted-target"
    return 0
}

# Exact parser for Native's app-private current-boot transport. The UUID changes every Linux boot,
# so a stale file cannot activate Apollo before Native restores the persisted target. Unknown,
# duplicate and partial fields fail closed.
apollo_runtime_flag_enabled() {
    [ -r "$APOLLO_RUNTIME_FLAG" ] || return 1
    APOLLO_CURRENT_BOOT=
    IFS= read -r APOLLO_CURRENT_BOOT < "$APOLLO_BOOT_ID_FILE" || return 1
    [ -n "$APOLLO_CURRENT_BOOT" ] || return 1

    APOLLO_FLAG_V=
    APOLLO_FLAG_BOOT=
    APOLLO_FLAG_ENABLED=
    APOLLO_FLAG_SEEN_V=0
    APOLLO_FLAG_SEEN_BOOT=0
    APOLLO_FLAG_SEEN_ENABLED=0
    while IFS='=' read -r APOLLO_FLAG_KEY APOLLO_FLAG_VALUE; do
        [ -n "$APOLLO_FLAG_KEY" ] || continue
        case "$APOLLO_FLAG_KEY" in
            v)
                [ "$APOLLO_FLAG_SEEN_V" = 0 ] || return 1
                APOLLO_FLAG_SEEN_V=1
                APOLLO_FLAG_V=$APOLLO_FLAG_VALUE
                ;;
            boot)
                [ "$APOLLO_FLAG_SEEN_BOOT" = 0 ] || return 1
                APOLLO_FLAG_SEEN_BOOT=1
                APOLLO_FLAG_BOOT=$APOLLO_FLAG_VALUE
                ;;
            enabled)
                [ "$APOLLO_FLAG_SEEN_ENABLED" = 0 ] || return 1
                APOLLO_FLAG_SEEN_ENABLED=1
                APOLLO_FLAG_ENABLED=$APOLLO_FLAG_VALUE
                ;;
            *) return 1 ;;
        esac
    done < "$APOLLO_RUNTIME_FLAG"

    [ "$APOLLO_FLAG_SEEN_V" = 1 ] \
        && [ "$APOLLO_FLAG_SEEN_BOOT" = 1 ] \
        && [ "$APOLLO_FLAG_SEEN_ENABLED" = 1 ] \
        && [ "$APOLLO_FLAG_V" = 1 ] \
        && [ "$APOLLO_FLAG_BOOT" = "$APOLLO_CURRENT_BOOT" ] \
        && [ "$APOLLO_FLAG_ENABLED" = 1 ]
}

# Монотонные секунды с boot; после reboot старый timestamp автоматически выглядит протухшим.
uptime_seconds() {
    UPTIME_NOW=$(cut -d. -f1 /proc/uptime 2>/dev/null)
    case "$UPTIME_NOW" in
        ''|*[!0-9]*) date +%s ;;
        *) echo "$UPTIME_NOW" ;;
    esac
}

# multidisplay is the only retryable injector. Its attempt record is bound to the same exact
# process identity as every success marker and persists count/deadline atomically:
#     identity|attempt-count|next-allowed-uptime
# A legacy one-shot record containing only identity is treated as attempt 1 due now.
read_md_attempt_record() {
    MD_RECORD_FILE=$1
    MD_RECORD_RAW=
    MD_RECORD_ID=
    MD_RECORD_COUNT=0
    MD_RECORD_NEXT=0
    [ ! -r "$MD_RECORD_FILE" ] || IFS= read -r MD_RECORD_RAW < "$MD_RECORD_FILE"
    [ -n "$MD_RECORD_RAW" ] || return 1
    case "$MD_RECORD_RAW" in
        *'|'*'|'*)
            MD_RECORD_ID=${MD_RECORD_RAW%%|*}
            MD_RECORD_REST=${MD_RECORD_RAW#*|}
            MD_RECORD_COUNT=${MD_RECORD_REST%%|*}
            MD_RECORD_NEXT=${MD_RECORD_REST#*|}
            case "$MD_RECORD_NEXT" in *'|'*) return 1 ;; esac
            ;;
        v2:*)
            MD_RECORD_ID=$MD_RECORD_RAW
            MD_RECORD_COUNT=1
            MD_RECORD_NEXT=0
            ;;
        *) return 1 ;;
    esac
    case "$MD_RECORD_ID" in v2:*) ;; *) return 1 ;; esac
    case "$MD_RECORD_COUNT" in ''|*[!0-9]*) return 1 ;; esac
    case "$MD_RECORD_NEXT" in ''|*[!0-9]*) return 1 ;; esac
    [ "$MD_RECORD_COUNT" -ge 1 ] && [ "$MD_RECORD_COUNT" -le "$MD_MAX_ATTEMPTS" ] \
        || return 1
    return 0
}

write_md_attempt_record() {
    MD_WRITE_FILE=$1
    MD_WRITE_ID=$2
    MD_WRITE_COUNT=$3
    MD_WRITE_NEXT=$4
    MD_WRITE_TMP="$MD_WRITE_FILE.$$.new"
    if ! printf '%s|%s|%s\n' "$MD_WRITE_ID" "$MD_WRITE_COUNT" "$MD_WRITE_NEXT" \
            > "$MD_WRITE_TMP" || ! mv -f "$MD_WRITE_TMP" "$MD_WRITE_FILE"; then
        rm -f "$MD_WRITE_TMP"
        loge "multidisplay attempt marker write FAIL: $MD_WRITE_FILE"
        return 1
    fi
    return 0
}

md_retry_delay() {
    case "$1" in
        1) echo "$MD_RETRY_SHORT_SECONDS" ;;
        2) echo "$MD_RETRY_LONG_SECONDS" ;;
        *) echo 0 ;;
    esac
}

# Reserve persistently before frida-inject. Exposes MD_RESERVED_ATTEMPT to the caller.
reserve_md_injection_attempt() {
    MD_RESERVE_ID=$1
    MD_RESERVE_FILE=$2
    MD_RESERVED_ATTEMPT=1
    MD_PREVIOUS_COUNT=0
    MD_PREVIOUS_NEXT=0
    if read_md_attempt_record "$MD_RESERVE_FILE" && [ "$MD_RECORD_ID" = "$MD_RESERVE_ID" ]; then
        MD_PREVIOUS_COUNT=$MD_RECORD_COUNT
        MD_PREVIOUS_NEXT=$MD_RECORD_NEXT
        [ "$MD_PREVIOUS_COUNT" -lt "$MD_MAX_ATTEMPTS" ] || return 1
        MD_RESERVE_NOW=$(uptime_seconds)
        case "$MD_RESERVE_NOW" in ''|*[!0-9]*) return 1 ;; esac
        [ "$MD_PREVIOUS_NEXT" -le "$MD_RESERVE_NOW" ] || return 1
        MD_RESERVED_ATTEMPT=$((MD_PREVIOUS_COUNT + 1))
    fi
    MD_RESERVE_NOW=$(uptime_seconds)
    case "$MD_RESERVE_NOW" in ''|*[!0-9]*) return 1 ;; esac
    MD_RESERVE_DELAY=$(md_retry_delay "$MD_RESERVED_ATTEMPT")
    MD_RESERVE_NEXT=$((MD_RESERVE_NOW + MD_RESERVE_DELAY))
    write_md_attempt_record "$MD_RESERVE_FILE" "$MD_RESERVE_ID" \
        "$MD_RESERVED_ATTEMPT" "$MD_RESERVE_NEXT"
}

record_md_injection_failure() {
    MD_FAILURE_ID=$1
    MD_FAILURE_FILE=$2
    MD_FAILURE_ATTEMPT=$3
    MD_FAILURE_REASON=${4:-generic}
    # Never let a stale result overwrite the reservation of a newer process/attempt.
    if ! read_md_attempt_record "$MD_FAILURE_FILE" \
            || [ "$MD_RECORD_ID" != "$MD_FAILURE_ID" ] \
            || [ "$MD_RECORD_COUNT" -ne "$MD_FAILURE_ATTEMPT" ]; then
        return 1
    fi
    MD_FAILURE_NOW=$(uptime_seconds)
    case "$MD_FAILURE_NOW" in ''|*[!0-9]*) return 1 ;; esac
    if { [ "$MD_FAILURE_REASON" = agent_core_failure ] \
            || [ "$MD_FAILURE_REASON" = ready_marker_missing ]; } \
            && [ "$MD_FAILURE_ATTEMPT" -lt "$MD_MAX_ATTEMPTS" ]; then
        MD_FAILURE_DELAY=$MD_RETRY_CORE_SECONDS
    else
        MD_FAILURE_DELAY=$(md_retry_delay "$MD_FAILURE_ATTEMPT")
    fi
    MD_FAILURE_NEXT=$((MD_FAILURE_NOW + MD_FAILURE_DELAY))
    write_md_attempt_record "$MD_FAILURE_FILE" "$MD_FAILURE_ID" \
        "$MD_FAILURE_ATTEMPT" "$MD_FAILURE_NEXT"
}

record_md_injection_success() {
    # A terminal attempt record prevents duplicate GumJS agents if the success marker is later
    # removed manually. The exact success marker still takes precedence in runtime state.
    write_md_attempt_record "$2" "$1" "$MD_MAX_ATTEMPTS" 0
}

load_md_runtime_hook_state() {
    MD_RUNTIME_ID=$1
    MD_RUNTIME_MARK=$2
    MD_RUNTIME_ATTEMPT=$3
    MD_RUNTIME_MARK_VALUE=
    [ ! -r "$MD_RUNTIME_MARK" ] \
        || IFS= read -r MD_RUNTIME_MARK_VALUE < "$MD_RUNTIME_MARK"
    if [ -z "$MD_RUNTIME_ID" ]; then
        RUNTIME_STATE=waiting
    elif [ "$MD_RUNTIME_MARK_VALUE" = "$MD_RUNTIME_ID" ]; then
        RUNTIME_STATE=active
    elif read_md_attempt_record "$MD_RUNTIME_ATTEMPT" \
            && [ "$MD_RECORD_ID" = "$MD_RUNTIME_ID" ]; then
        if [ "$MD_RECORD_COUNT" -ge "$MD_MAX_ATTEMPTS" ]; then
            RUNTIME_STATE=failed
        else
            MD_RUNTIME_NOW=$(uptime_seconds)
            case "$MD_RUNTIME_NOW" in
                ''|*[!0-9]*) RUNTIME_STATE=injecting ;;
                *)
                    if [ "$MD_RECORD_NEXT" -gt "$MD_RUNTIME_NOW" ]; then
                        RUNTIME_STATE=injecting
                    else
                        RUNTIME_STATE=waiting
                    fi
                    ;;
            esac
        fi
    else
        RUNTIME_STATE=waiting
    fi
}

# Exact-ready multidisplay injector. A timeout/exit 0 without the agent marker is a failed attempt;
# a marker is accepted even when eternalize made the wrapper time out. Internal agent failures have
# their own marker and therefore cannot become a false active state.
inject_multidisplay() {
    MD_INJECT_PID=$1
    MD_INJECT_ID=$2
    MD_LAST_FAILURE=
    reserve_md_injection_attempt "$MD_INJECT_ID" "$MD_ATTEMPT" || return 1
    MD_INJECT_ATTEMPT=$MD_RESERVED_ATTEMPT
    MD_CURRENT_ID=$(process_identity "$MD_INJECT_PID" com.qinggan.systemservice 2>/dev/null) \
        || MD_CURRENT_ID=
    if [ "$MD_CURRENT_ID" != "$MD_INJECT_ID" ]; then
        loge "multidisplay inject skipped: target identity changed before launch"
        record_md_injection_failure "$MD_INJECT_ID" "$MD_ATTEMPT" \
            "$MD_INJECT_ATTEMPT" || true
        return 1
    fi

    MD_LOG=/data/local/tmp/voyahtune_md.txt
    MD_TRY="$MD_LOG.try"
    : > "$MD_TRY"
    timeout -k 5 30 "$FI" -p "$MD_INJECT_PID" -s "$MD" -e > "$MD_TRY" 2>&1
    MD_RC=$?
    cat "$MD_TRY" >> "$MD_LOG"

    MD_INJECT_FAILURE=
    # Agent marker wins over generic words in its error detail (e.g. "class not found"). Explicit
    # rollback and missing-ready (sentinel-protected) are the only 2s bootstrap retry reasons.
    if grep -qF "$MD_FAILURE_MARKER " "$MD_TRY"; then
        MD_INJECT_FAILURE=agent_core_failure
    elif grep -qiE 'unable to find|not found|failed to|cannot parse|no such process|error resolving' \
            "$MD_TRY"; then
        MD_INJECT_FAILURE=injector_error
    elif ! grep -qF "$MD_READY_MARKER " "$MD_TRY"; then
        MD_INJECT_FAILURE=ready_marker_missing
    fi
    if [ -n "$MD_INJECT_FAILURE" ]; then
        MD_LAST_FAILURE=$MD_INJECT_FAILURE
        record_md_injection_failure "$MD_INJECT_ID" "$MD_ATTEMPT" \
            "$MD_INJECT_ATTEMPT" "$MD_INJECT_FAILURE" || true
        loge "multidisplay inject FAIL pid=$MD_INJECT_PID attempt=$MD_INJECT_ATTEMPT/$MD_MAX_ATTEMPTS rc=$MD_RC reason=$MD_INJECT_FAILURE"
        return 1
    fi

    MD_AFTER_ID=$(process_identity "$MD_INJECT_PID" com.qinggan.systemservice 2>/dev/null) \
        || MD_AFTER_ID=
    if [ "$MD_AFTER_ID" != "$MD_INJECT_ID" ]; then
        record_md_injection_failure "$MD_INJECT_ID" "$MD_ATTEMPT" \
            "$MD_INJECT_ATTEMPT" || true
        loge "multidisplay inject result stale pid=$MD_INJECT_PID attempt=$MD_INJECT_ATTEMPT"
        return 1
    fi

    # Latch success before publishing the marker: if local storage fails midway, the next cycle can
    # never mistake a mere frida exit-code for success, and retries remain capped at three.
    record_md_injection_success "$MD_INJECT_ID" "$MD_ATTEMPT" || true
    MD_MARK_TMP="$MD_MARK.$$.new"
    if ! printf '%s\n' "$MD_INJECT_ID" > "$MD_MARK_TMP" \
            || ! mv -f "$MD_MARK_TMP" "$MD_MARK"; then
        rm -f "$MD_MARK_TMP"
        loge "multidisplay marker write FAIL pid=$MD_INJECT_PID (terminal retry latch kept)"
        return 1
    fi
    rm -f "$MD_TRY"
    logi "multidisplay inject OK pid=$MD_INJECT_PID attempt=$MD_INJECT_ATTEMPT/$MD_MAX_ATTEMPTS"
    return 0
}

# `timeout` uses a clock that may pause in suspend on some Toybox builds, while /proc/uptime can
# advance across suspend. Before expiring a TTL record, verify that its actual injector child is
# gone; otherwise a long sleep could create a second injection while the first still has time left.
keymanager_inject_is_live() {
    for KM_INJECT_PID in $(pidof frida-inject 2>/dev/null); do
        KM_INJECT_CMD=$(tr '\000' ' ' < "/proc/$KM_INJECT_PID/cmdline" 2>/dev/null)
        case "$KM_INJECT_CMD" in
            *"-p $1 "*"steeringwheelkeys.js"*) return 0 ;;
        esac
    done
    return 1
}

# keymanager на части прошивок не возвращает управление после успешного -e. Busy-symlink создаётся
# атомарно и представляет ГЛОБАЛЬНУЮ single-flight попытку (не только попытку на конкретный target PID).
# Если worker был убит до cleanup, TTL освобождает stale busy после гарантированного TERM->KILL окна.
inject_keymanager_bg() {
    KM_TARGET_PID="$1"
    KM_TARGET_ID="$2"
    KM_NOW=$(uptime_seconds)
    [ "$(cat "$SWK_KM_MARK" 2>/dev/null)" = "$KM_TARGET_ID" ] && return 0
    [ "$(cat "$SWK_KM_ATTEMPT" 2>/dev/null)" = "$KM_TARGET_ID" ] && return 0

    KM_BUSY_ATTEMPTS=0
    KM_BUSY_MAX_ATTEMPTS=3
    while [ 1 ]; do
        KM_NOW=$(uptime_seconds)
        KM_BUSY_RECORD=$(readlink "$SWK_KM_BUSY" 2>/dev/null)

        if [ -L "$SWK_KM_BUSY" ]; then
            KM_BUSY_TARGET=${KM_BUSY_RECORD%%|*}
            KM_BUSY_REST=${KM_BUSY_RECORD#*|}
            KM_BUSY_STARTED=${KM_BUSY_REST%%|*}
            case "$KM_NOW" in
                ''|*[!0-9]*) KM_BUSY_AGE=$SWK_KM_BUSY_TTL ;;
                *)
                    case "$KM_BUSY_STARTED" in
                        ''|*[!0-9]*) KM_BUSY_AGE=$SWK_KM_BUSY_TTL ;;
                        *) KM_BUSY_AGE=$((KM_NOW - KM_BUSY_STARTED)) ;;
                    esac
                    ;;
            esac
            if [ "$KM_BUSY_AGE" -ge 0 ] && [ "$KM_BUSY_AGE" -lt "$SWK_KM_BUSY_TTL" ]; then
                return 0
            fi
            if keymanager_inject_is_live "$KM_BUSY_TARGET"; then
                logi "keep keymanager injection busy: live injector pid target=$KM_BUSY_TARGET"
                return 0
            fi
            logi "clear stale keymanager injection busy age=${KM_BUSY_AGE}s record=$KM_BUSY_RECORD"
            # Один loader владеет owner-lock; conditional read защищает от cleanup завершившегося worker.
            [ "$(readlink "$SWK_KM_BUSY" 2>/dev/null)" = "$KM_BUSY_RECORD" ] \
                && rm -f "$SWK_KM_BUSY"
            continue
        elif [ -e "$SWK_KM_BUSY" ]; then
            # Миграция с legacy regular-file busy (там лежал только target PID).
            logi "clear legacy keymanager injection busy"
            rm -f "$SWK_KM_BUSY"
            continue
        fi

        KM_TOKEN="$$.$KM_NOW.$KM_TARGET_PID"
        KM_RECORD="$KM_TARGET_PID|$KM_NOW|$KM_TOKEN"
        if ln -s "$KM_RECORD" "$SWK_KM_BUSY" 2>/dev/null; then
            break
        fi
        KM_BUSY_ATTEMPTS=$((KM_BUSY_ATTEMPTS + 1))
        if [ "$KM_BUSY_ATTEMPTS" -ge "$KM_BUSY_MAX_ATTEMPTS" ]; then
            loge "keymanager busy marker unavailable; defer without injecting"
            return 0
        fi
        sleep 1
    done

    # Reserve before forking. Failure/timeout keeps the exact identity latched permanently; only a
    # new keymanager process identity may get another attempt.
    if ! reserve_injection_attempt "$KM_TARGET_ID" "$SWK_KM_ATTEMPT"; then
        [ "$(readlink "$SWK_KM_BUSY" 2>/dev/null)" = "$KM_RECORD" ] && rm -f "$SWK_KM_BUSY"
        return 0
    fi
    # Clear the previous identity's ready marker before publishing a new background attempt.
    KM_TRY="/data/local/tmp/voyahtune_swk.try"
    : > "$KM_TRY"
    logi "inject steeringwheelkeys -> keymanager $KM_TARGET_PID (eternalize,one-shot)"
    (
        # Не наследуем loader traps: worker живёт не дольше timeout+KILL и сам чистит busy.
        trap - 0 HUP INT TERM
        KM_ID_BEFORE=$(process_identity "$KM_TARGET_PID" com.qinggan.keymanager.service 2>/dev/null) \
            || KM_ID_BEFORE=
        if [ "$KM_ID_BEFORE" != "$KM_TARGET_ID" ]; then
            [ "$(readlink "$SWK_KM_BUSY" 2>/dev/null)" != "$KM_RECORD" ] || rm -f "$SWK_KM_BUSY"
            exit 1
        fi
        timeout -k 5 30 "$FI" -p "$KM_TARGET_PID" -s "$SWK" -e > "$KM_TRY" 2>&1
        KM_RC=$?
        cat "$KM_TRY" >> /data/local/tmp/voyahtune_swk.txt
        if grep -qF '[swk] keymanager hooks installed:' "$KM_TRY"; then
            KM_ID_AFTER=$(process_identity "$KM_TARGET_PID" com.qinggan.keymanager.service 2>/dev/null) \
                || KM_ID_AFTER=
            if [ "$KM_ID_AFTER" = "$KM_TARGET_ID" ]; then
                KM_MARK_TMP="$SWK_KM_MARK.$$.new"
                if printf '%s\n' "$KM_TARGET_ID" > "$KM_MARK_TMP" \
                        && mv -f "$KM_MARK_TMP" "$SWK_KM_MARK"; then
                    logi "inject OK keymanager pid=$KM_TARGET_PID"
                else
                    rm -f "$KM_MARK_TMP"
                    loge "inject marker write FAIL keymanager pid=$KM_TARGET_PID (latched; no retry)"
                fi
            else
                loge "inject result stale keymanager pid=$KM_TARGET_PID (latched old identity)"
            fi
        else
            loge "inject FAIL keymanager pid=$KM_TARGET_PID rc=$KM_RC (latched; no retry)"
        fi
        rm -f "$KM_TRY"
        [ "$(readlink "$SWK_KM_BUSY" 2>/dev/null)" = "$KM_RECORD" ] \
            && rm -f "$SWK_KM_BUSY"
    ) &
}

# The optional per-app lane keeps one global background injector. A slow third-party process
# can never hold up dock/VD/steering discovery or status.
# Both the attempt and success markers are bound to exact boot+pid+start-time identity.
app_client_inject_is_live() {
    # Inspect the bounded cmdline set instead of relying on the kernel's truncated process name.
    # This scan runs only when a busy marker has already exceeded its 45-second TTL.
    for FC_INJECT_CMDLINE in /proc/[0-9]*/cmdline; do
        [ -r "$FC_INJECT_CMDLINE" ] || continue
        FC_INJECT_CMD=$(tr '\000' ' ' < "$FC_INJECT_CMDLINE" 2>/dev/null)
        case "$FC_INJECT_CMD" in
            *"-p $1 "*"app_client.js"*) return 0 ;;
        esac
    done
    return 1
}

# Two process deaths inside the short post-injection window block this package until reboot. This
# prevents a broken OEM/agent combination from turning an optional fullscreen repair into an app
# crash-loop, while an ordinary restart after a stable session remains injectable.
#   $1=package  $2=exact identity  $3=history-file  $4=blocked-file
prepare_app_client_attempt() {
    FC_PREP_PACKAGE=$1
    FC_PREP_ID=$2
    FC_PREP_HISTORY=$3
    FC_PREP_BLOCKED=$4
    FC_PREP_BOOT=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || return 1
    FC_PREP_NOW=$(uptime_seconds)
    case "$FC_PREP_NOW" in ''|*[!0-9]*) return 1 ;; esac

    [ "$(cat "$FC_PREP_BLOCKED" 2>/dev/null)" != "$FC_PREP_BOOT" ] || return 1
    FC_PREP_RAPID=0
    FC_PREP_VALUE=$(cat "$FC_PREP_HISTORY" 2>/dev/null)
    FC_PREP_OLD_BOOT=${FC_PREP_VALUE%%|*}
    FC_PREP_REST=${FC_PREP_VALUE#*|}
    FC_PREP_OLD_TIME=${FC_PREP_REST%%|*}
    FC_PREP_REST=${FC_PREP_REST#*|}
    FC_PREP_OLD_RAPID=${FC_PREP_REST%%|*}
    FC_PREP_OLD_ID=${FC_PREP_REST#*|}
    if [ -n "$FC_PREP_VALUE" ] && [ "$FC_PREP_OLD_BOOT" = "$FC_PREP_BOOT" ] \
            && [ "$FC_PREP_OLD_ID" != "$FC_PREP_ID" ]; then
        case "$FC_PREP_OLD_TIME:$FC_PREP_OLD_RAPID" in
            *[!0-9:]*|:*|*:) ;;
            *)
                FC_PREP_AGE=$((FC_PREP_NOW - FC_PREP_OLD_TIME))
                if [ "$FC_PREP_AGE" -ge 0 ] \
                        && [ "$FC_PREP_AGE" -lt "$APP_CLIENT_CRASH_WINDOW" ]; then
                    FC_PREP_RAPID=$((FC_PREP_OLD_RAPID + 1))
                fi
                ;;
        esac
    fi
    if [ "$FC_PREP_RAPID" -ge "$APP_CLIENT_MAX_RAPID_RESTARTS" ]; then
        printf '%s\n' "$FC_PREP_BOOT" > "$FC_PREP_BLOCKED"
        loge "app client blocked after rapid restarts package=$FC_PREP_PACKAGE"
        return 1
    fi
    FC_PREP_TMP="$FC_PREP_HISTORY.$$.new"
    if ! printf '%s|%s|%s|%s\n' "$FC_PREP_BOOT" "$FC_PREP_NOW" "$FC_PREP_RAPID" \
            "$FC_PREP_ID" > "$FC_PREP_TMP" || ! mv -f "$FC_PREP_TMP" "$FC_PREP_HISTORY"; then
        rm -f "$FC_PREP_TMP"
        return 1
    fi
    return 0
}

#   $1=package $2=pid $3=identity $4=injector $5=marker $6=attempt $7=log $8=history $9=blocked
#   $10=1 when MapKit readiness is mandatory for this exact injection
inject_app_client_bg() {
    FC_TARGET_PACKAGE=$1
    FC_TARGET_PID=$2
    FC_TARGET_ID=$3
    FC_TARGET_INJECTOR=$4
    FC_TARGET_MARK=$5
    FC_TARGET_ATTEMPT=$6
    FC_TARGET_LOG=$7
    FC_TARGET_HISTORY=$8
    FC_TARGET_BLOCKED=$9
    FC_TARGET_REQUIRE_MAPKIT=${10}

    [ "$(cat "$FC_TARGET_MARK" 2>/dev/null)" = "$FC_TARGET_ID" ] && return 0
    [ "$(cat "$FC_TARGET_ATTEMPT" 2>/dev/null)" = "$FC_TARGET_ID" ] && return 0

    FC_BUSY_NOW=$(uptime_seconds)
    FC_BUSY_RECORD=$(readlink "$APP_CLIENT_BUSY" 2>/dev/null)
    if [ -L "$APP_CLIENT_BUSY" ]; then
        FC_BUSY_PID=${FC_BUSY_RECORD%%|*}
        FC_BUSY_REST=${FC_BUSY_RECORD#*|}
        FC_BUSY_STARTED=${FC_BUSY_REST%%|*}
        case "$FC_BUSY_NOW:$FC_BUSY_STARTED" in
            *[!0-9:]*|:*|*:) FC_BUSY_AGE=$APP_CLIENT_BUSY_TTL ;;
            *) FC_BUSY_AGE=$((FC_BUSY_NOW - FC_BUSY_STARTED)) ;;
        esac
        if [ "$FC_BUSY_AGE" -ge 0 ] && [ "$FC_BUSY_AGE" -lt "$APP_CLIENT_BUSY_TTL" ]; then
            return 0
        fi
        if app_client_inject_is_live "$FC_BUSY_PID"; then
            return 0
        fi
        [ "$(readlink "$APP_CLIENT_BUSY" 2>/dev/null)" = "$FC_BUSY_RECORD" ] \
            && rm -f "$APP_CLIENT_BUSY"
    elif [ -e "$APP_CLIENT_BUSY" ]; then
        rm -f "$APP_CLIENT_BUSY"
    fi

    FC_BUSY_TOKEN="$$.$FC_BUSY_NOW.$FC_TARGET_PID"
    FC_BUSY_OWN_RECORD="$FC_TARGET_PID|$FC_BUSY_NOW|$FC_BUSY_TOKEN"
    ln -s "$FC_BUSY_OWN_RECORD" "$APP_CLIENT_BUSY" 2>/dev/null || return 0
    FC_CURRENT_ID=$(process_identity "$FC_TARGET_PID" "$FC_TARGET_PACKAGE" 2>/dev/null) \
        || FC_CURRENT_ID=
    if [ "$FC_CURRENT_ID" != "$FC_TARGET_ID" ]; then
        loge "app client skipped: target identity changed package=$FC_TARGET_PACKAGE"
        [ "$(readlink "$APP_CLIENT_BUSY" 2>/dev/null)" = "$FC_BUSY_OWN_RECORD" ] \
            && rm -f "$APP_CLIENT_BUSY"
        return 0
    fi
    if ! prepare_app_client_attempt "$FC_TARGET_PACKAGE" "$FC_TARGET_ID" \
            "$FC_TARGET_HISTORY" "$FC_TARGET_BLOCKED"; then
        [ "$(readlink "$APP_CLIENT_BUSY" 2>/dev/null)" = "$FC_BUSY_OWN_RECORD" ] \
            && rm -f "$APP_CLIENT_BUSY"
        return 0
    fi
    if ! reserve_injection_attempt "$FC_TARGET_ID" "$FC_TARGET_ATTEMPT"; then
        [ "$(readlink "$APP_CLIENT_BUSY" 2>/dev/null)" = "$FC_BUSY_OWN_RECORD" ] \
            && rm -f "$APP_CLIENT_BUSY"
        return 0
    fi

    logi "inject app client package=$FC_TARGET_PACKAGE pid=$FC_TARGET_PID"
    (
        trap - 0 HUP INT TERM
        FC_TRY="$FC_TARGET_LOG.try"
        : > "$FC_TRY"
        FC_ID_BEFORE=$(process_identity "$FC_TARGET_PID" "$FC_TARGET_PACKAGE" 2>/dev/null) \
            || FC_ID_BEFORE=
        if [ "$FC_ID_BEFORE" = "$FC_TARGET_ID" ]; then
            timeout -k 5 30 "$FC_TARGET_INJECTOR" -p "$FC_TARGET_PID" \
                -s "$APP_CLIENT" -e > "$FC_TRY" 2>&1
            FC_RC=$?
        else
            printf '%s\n' "target identity changed before frida-inject" > "$FC_TRY"
            FC_RC=1
        fi
        cat "$FC_TRY" >> "$FC_TARGET_LOG"
        FC_READY_OK=0
        if [ "$FC_RC" -eq 0 ] && grep -qF "$APP_CLIENT_READY" "$FC_TRY"; then
            if [ "$FC_TARGET_REQUIRE_MAPKIT" != 1 ] \
                    || grep -qF "$MAPKIT_DPI_CLIENT_READY" "$FC_TRY"; then
                FC_READY_OK=1
            fi
        fi
        if [ "$FC_READY_OK" -eq 1 ]; then
            FC_ID_AFTER=$(process_identity "$FC_TARGET_PID" "$FC_TARGET_PACKAGE" 2>/dev/null) \
                || FC_ID_AFTER=
            if [ "$FC_ID_AFTER" = "$FC_TARGET_ID" ]; then
                FC_MARK_TMP="$FC_TARGET_MARK.$$.new"
                if printf '%s\n' "$FC_TARGET_ID" > "$FC_MARK_TMP" \
                        && mv -f "$FC_MARK_TMP" "$FC_TARGET_MARK"; then
                    logi "inject OK app client package=$FC_TARGET_PACKAGE pid=$FC_TARGET_PID"
                else
                    rm -f "$FC_MARK_TMP"
                    loge "app client marker write FAIL package=$FC_TARGET_PACKAGE"
                fi
            else
                loge "app client result stale package=$FC_TARGET_PACKAGE pid=$FC_TARGET_PID"
            fi
        else
            loge "inject FAIL app client package=$FC_TARGET_PACKAGE pid=$FC_TARGET_PID rc=$FC_RC mapkit_required=$FC_TARGET_REQUIRE_MAPKIT"
        fi
        rm -f "$FC_TRY"
        [ "$(readlink "$APP_CLIENT_BUSY" 2>/dev/null)" = "$FC_BUSY_OWN_RECORD" ] \
            && rm -f "$APP_CLIENT_BUSY"
    ) &
}

discover_app_client() {
    # SettingsProvider is outside this process; keep both Binder reads bounded within this optional lane.
    # DPI alone may request this agent only for the three exact MapKit packages below. Other apps
    # keep the server-side density override without acquiring an unnecessary client hook.
    FC_FULLSCREEN_LIST=$(timeout -k 1 1 settings get global "$APP_CLIENT_FULLSCREEN_SETTING" \
        2>/dev/null) || FC_FULLSCREEN_LIST=
    FC_DPI_LIST=$(timeout -k 1 1 settings get global "$APP_CLIENT_DPI_SETTING" \
        2>/dev/null) || FC_DPI_LIST=
    case "$FC_FULLSCREEN_LIST" in null) FC_FULLSCREEN_LIST= ;; esac
    case "$FC_DPI_LIST" in null) FC_DPI_LIST= ;; esac
    FC_DPI_LIST=$(printf '%s' "$FC_DPI_LIST" | tr -d '[:space:]')
    FC_LIST=$FC_FULLSCREEN_LIST
    FC_SAVED_IFS=$IFS
    IFS=,
    for FC_DPI_PACKAGE in $FC_DPI_LIST; do
        IFS=$FC_SAVED_IFS
        case "$FC_DPI_PACKAGE" in
            ru.yandex.yandexnavi|ru.yandex.yandexmaps|com.yango.maps.android)
                FC_LIST="${FC_LIST}${FC_LIST:+,}$FC_DPI_PACKAGE"
                ;;
        esac
        IFS=,
    done
    IFS=$FC_SAVED_IFS
    case "$FC_LIST" in '') return ;; esac
    IFS=,
    for FC_PACKAGE in $FC_LIST; do
        IFS=$FC_SAVED_IFS
        FC_PACKAGE=$(printf '%s' "$FC_PACKAGE" | tr -d '[:space:]')
        # Core OEM targets have dedicated workers. Optional app geometry must not attach another
        # agent to them concurrently (the supported client scope is third-party applications).
        case "$FC_PACKAGE" in
            com.qinggan.keymanager.service|com.qinggan.systemservice|com.qinggan.app.launcher|\
            com.qinggan.app.vehiclesetting|com.qinggan.app.qgime)
                IFS=,
                continue
                ;;
        esac
        case "$FC_PACKAGE" in ''|.*|*.|*..*|*[!A-Za-z0-9._]*) IFS=,; continue ;; esac
        FC_REQUIRE_MAPKIT=0
        case "$FC_PACKAGE" in
            ru.yandex.yandexnavi|ru.yandex.yandexmaps|com.yango.maps.android)
                case ",$FC_DPI_LIST," in
                    *",$FC_PACKAGE,"*) FC_REQUIRE_MAPKIT=1 ;;
                esac
                ;;
        esac
        FC_PID=
        FC_ID=
        for FC_CANDIDATE in $(pidof "$FC_PACKAGE" 2>/dev/null); do
            FC_CANDIDATE_ID=$(process_identity "$FC_CANDIDATE" "$FC_PACKAGE" 2>/dev/null) \
                || FC_CANDIDATE_ID=
            [ -n "$FC_CANDIDATE_ID" ] || continue
            FC_UID=$(awk '/^Uid:/{print $2; exit}' "/proc/$FC_CANDIDATE/status" 2>/dev/null)
            case "$FC_UID" in ''|*[!0-9]*) continue ;; esac
            [ "$FC_UID" -lt 100000 ] || continue
            FC_PID=$FC_CANDIDATE
            FC_ID=$FC_CANDIDATE_ID
            break
        done
        if [ -z "$FC_ID" ]; then IFS=,; continue; fi

        FC_BASE="/data/local/tmp/voyahtune_app_client.$FC_PACKAGE"
        FC_MARK="$FC_BASE.pid"
        FC_ATTEMPT="$FC_BASE.attempt"
        FC_LOG="$FC_BASE.txt"
        FC_HISTORY="$FC_BASE.history"
        FC_BLOCKED="$FC_BASE.blocked"
        FC_BOOT=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
        if [ -n "$FC_BOOT" ] && [ "$(cat "$FC_BLOCKED" 2>/dev/null)" = "$FC_BOOT" ]; then
            IFS=,
            continue
        fi
        if [ "$(cat "$FC_MARK" 2>/dev/null)" = "$FC_ID" ] \
                || [ "$(cat "$FC_ATTEMPT" 2>/dev/null)" = "$FC_ID" ]; then
            IFS=,
            continue
        fi
        FC_EXE=$(readlink "/proc/$FC_PID/exe" 2>/dev/null)
        case "$FC_EXE" in
            *app_process64) FC_INJECTOR=$FI ;;
            *)
                reserve_injection_attempt "$FC_ID" "$FC_ATTEMPT" || true
                loge "app client unsupported process ABI package=$FC_PACKAGE exe=$FC_EXE"
                IFS=,
                continue
                ;;
        esac
        if [ ! -x "$FC_INJECTOR" ] || [ ! -r "$APP_CLIENT" ]; then
            reserve_injection_attempt "$FC_ID" "$FC_ATTEMPT" || true
            loge "app client assets unavailable package=$FC_PACKAGE injector=$FC_INJECTOR"
            IFS=,
            continue
        fi
        inject_app_client_bg "$FC_PACKAGE" "$FC_PID" "$FC_ID" "$FC_INJECTOR" \
            "$FC_MARK" "$FC_ATTEMPT" "$FC_LOG" "$FC_HISTORY" "$FC_BLOCKED" \
            "$FC_REQUIRE_MAPKIT"
        IFS=$FC_SAVED_IFS
        return
    done
    IFS=$FC_SAVED_IFS
}

steering_cycle() {
    KMP=$(pidof com.qinggan.keymanager.service 2>/dev/null)
    KMP=${KMP%% *}
    KMP_ID=$(process_identity "$KMP" com.qinggan.keymanager.service 2>/dev/null) || KMP_ID=
    load_runtime_hook_state "$KMP_ID" "$SWK_KM_MARK" "$SWK_KM_ATTEMPT"
    SWK_STATE=$RUNTIME_STATE
    if [ -n "$KMP_ID" ] && [ "$SWK_STATE" = waiting ]; then
        inject_keymanager_bg "$KMP" "$KMP_ID"
    fi
    STATUS_BUSY_RECORD=$(readlink "$SWK_KM_BUSY" 2>/dev/null)
    if [ -n "$KMP_ID" ] && [ "$SWK_STATE" != active ] \
            && [ "${STATUS_BUSY_RECORD%%|*}" = "$KMP" ]; then
        SWK_STATE=injecting
        # Agent readiness, not the injector's eventual exit, controls the visible ready state.
        if [ "$(cat "$SWK_KM_ATTEMPT" 2>/dev/null)" = "$KMP_ID" ] \
                && grep -qF '[swk] keymanager hooks installed:' /data/local/tmp/voyahtune_swk.try \
                    2>/dev/null; then
            SWK_STATE=active
        fi
    fi
    write_worker_state "$SWK_STATE" "$KMP" "$KMP_ID"
}

multidisplay_cycle() {
    MDP=$(pidof com.qinggan.systemservice)
    MDP=${MDP%% *}
    MDP_ID=$(process_identity "$MDP" com.qinggan.systemservice 2>/dev/null) || MDP_ID=
    load_md_runtime_hook_state "$MDP_ID" "$MD_MARK" "$MD_ATTEMPT"
    MD_STATE=$RUNTIME_STATE
    if [ -n "$MDP_ID" ] && [ "$MD_STATE" = waiting ]; then
        write_worker_state injecting "$MDP" "$MDP_ID"
        if inject_multidisplay "$MDP" "$MDP_ID"; then
            MD_STATE=active
        else
            load_md_runtime_hook_state "$MDP_ID" "$MD_MARK" "$MD_ATTEMPT"
            MD_STATE=$RUNTIME_STATE
        fi
    fi
    write_worker_state "$MD_STATE" "$MDP" "$MDP_ID"
}

launcher_cycle() {
    LP=$(pidof com.qinggan.app.launcher)
    LP=${LP%% *}
    LP_ID=$(process_identity "$LP" com.qinggan.app.launcher 2>/dev/null) || LP_ID=
    load_runtime_hook_state "$LP_ID" "$LNCH_MARK" "$LNCH_ATTEMPT"
    LNCH_STATE=$RUNTIME_STATE
    if [ -n "$LP_ID" ] && [ "$LNCH_STATE" = waiting ]; then
        write_worker_state injecting "$LP" "$LP_ID"
        if inject_ret "$LP" "$LNCH" /data/local/tmp/voyahtune_lnch.txt \
                "$LNCH_MARK" "$LNCH_ATTEMPT" "$LP_ID" com.qinggan.app.launcher; then
            LNCH_STATE=active
        else
            LNCH_STATE=failed
        fi
    fi

    write_worker_state "$LNCH_STATE" "$LP" "$LP_ID"
}

vd_cycle() {
    SS=$(pidof system_server)
    SS=${SS%% *}
    SS_ID=$(process_identity "$SS" system_server 2>/dev/null) || SS_ID=
    load_runtime_hook_state "$SS_ID" "$VDMARK" "$VD_ATTEMPT"
    VD_STATE=$RUNTIME_STATE
    if [ -n "$SS_ID" ] && [ "$VD_STATE" = waiting ]; then
        write_worker_state injecting "$SS" "$SS_ID"
        if inject_ret "$SS" "$VD" /data/local/tmp/voyahtune_vd_bypass.txt \
                "$VDMARK" "$VD_ATTEMPT" "$SS_ID" system_server; then
            VD_STATE=active
        else
            VD_STATE=failed
        fi
    fi

    write_worker_state "$VD_STATE" "$SS" "$SS_ID"
}

apollo_cycle() {
    if apollo_runtime_flag_enabled; then
        APOLLO_PID=$(pidof "$APOLLO_TARGET" 2>/dev/null)
        APOLLO_PID=${APOLLO_PID%% *}
        APOLLO_ID=$(process_identity "$APOLLO_PID" "$APOLLO_TARGET" 2>/dev/null) || APOLLO_ID=
        load_runtime_hook_state "$APOLLO_ID" "$APOLLO_MARK" "$APOLLO_ATTEMPT"
        APOLLO_STATE=$RUNTIME_STATE
        if [ -n "$APOLLO_ID" ] && [ "$APOLLO_STATE" = waiting ]; then
            write_worker_state injecting "$APOLLO_PID" "$APOLLO_ID"
            if inject_apollo "$APOLLO_PID" "$APOLLO_ID"; then
                APOLLO_STATE=active
            else
                APOLLO_STATE=failed
            fi
        fi
    else
        APOLLO_PID=; APOLLO_ID=
        APOLLO_STATE=disabled
    fi

    write_worker_state "$APOLLO_STATE" "$APOLLO_PID" "$APOLLO_ID"
}

keyboard_cycle() {
    KEYBOARD_PID=$(pidof "$KEYBOARD_TARGET" 2>/dev/null)
    KEYBOARD_PID=${KEYBOARD_PID%% *}
    KEYBOARD_ID=$(process_identity "$KEYBOARD_PID" "$KEYBOARD_TARGET" 2>/dev/null) || KEYBOARD_ID=
    if [ -n "$KEYBOARD_ID" ] && [ "$KEYBOARD_SEEN_ID" != "$KEYBOARD_ID" ]; then
        KEYBOARD_SEEN_ID=$KEYBOARD_ID
        KEYBOARD_MODE=$(timeout -k 1 2 settings get global "$KEYBOARD_SETTING" 2>/dev/null) || KEYBOARD_MODE=off
        case "$KEYBOARD_MODE" in
            en|ru) KEYBOARD_MODE_CURRENT=$KEYBOARD_MODE ;;
            *)
                KEYBOARD_MODE_CURRENT=off
                logi "keyboard hook disabled for qgime pid=$KEYBOARD_PID"
                ;;
        esac
    fi
    case "$KEYBOARD_MODE_CURRENT" in
        en)
            KEYBOARD_RU_STATE=disabled
            load_runtime_hook_state "$KEYBOARD_ID" "$KEYBOARD_MARK" "$KEYBOARD_ATTEMPT"
            KEYBOARD_EN_STATE=$RUNTIME_STATE
            KEYBOARD_SCRIPT=$KEYBOARD_EN
            ;;
        ru)
            KEYBOARD_EN_STATE=disabled
            load_runtime_hook_state "$KEYBOARD_ID" "$KEYBOARD_MARK" "$KEYBOARD_ATTEMPT"
            KEYBOARD_RU_STATE=$RUNTIME_STATE
            KEYBOARD_SCRIPT=$KEYBOARD_RU
            ;;
        off)
            KEYBOARD_EN_STATE=disabled
            KEYBOARD_RU_STATE=disabled
            KEYBOARD_SCRIPT=
            ;;
        *)
            KEYBOARD_EN_STATE=unknown
            KEYBOARD_RU_STATE=unknown
            KEYBOARD_SCRIPT=
            ;;
    esac
    if [ -n "$KEYBOARD_ID" ] && [ -n "$KEYBOARD_SCRIPT" ]; then
        if [ "$KEYBOARD_EN_STATE" = waiting ] || [ "$KEYBOARD_RU_STATE" = waiting ]; then
            [ "$KEYBOARD_MODE_CURRENT" != en ] || KEYBOARD_EN_STATE=injecting
            [ "$KEYBOARD_MODE_CURRENT" != ru ] || KEYBOARD_RU_STATE=injecting
            write_worker_state "$KEYBOARD_EN_STATE" "$KEYBOARD_PID" "$KEYBOARD_ID" "$KEYBOARD_RU_STATE"
            if inject_ret "$KEYBOARD_PID" "$KEYBOARD_SCRIPT" "$KEYBOARD_LOG" \
                    "$KEYBOARD_MARK" "$KEYBOARD_ATTEMPT" "$KEYBOARD_ID" "$KEYBOARD_TARGET"; then
                [ "$KEYBOARD_MODE_CURRENT" = en ] && KEYBOARD_EN_STATE=active
                [ "$KEYBOARD_MODE_CURRENT" = ru ] && KEYBOARD_RU_STATE=active
            else
                [ "$KEYBOARD_MODE_CURRENT" = en ] && KEYBOARD_EN_STATE=failed
                [ "$KEYBOARD_MODE_CURRENT" = ru ] && KEYBOARD_RU_STATE=failed
            fi
        fi
    fi

    write_worker_state "$KEYBOARD_EN_STATE" "$KEYBOARD_PID" "$KEYBOARD_ID" "$KEYBOARD_RU_STATE"
}


SS=; SS_ID=
LP=; LP_ID=
KMP=; KMP_ID=
MDP=; MDP_ID=
APOLLO_PID=; APOLLO_ID=
KEYBOARD_PID=; KEYBOARD_ID=
VD_STATE=unknown
SWK_STATE=unknown
LNCH_STATE=unknown
MD_STATE=unknown
APOLLO_STATE=unknown
KEYBOARD_EN_STATE=unknown
KEYBOARD_RU_STATE=unknown

# Worker ownership is bound to boot + PID + start time, including across supervisor restarts.
# These tokens identify shell workers, whereas process_identity also checks the Android package.
worker_token() {
    WT_PID=$1
    case "$WT_PID" in ''|*[!0-9]*) return 1 ;; esac
    # These checks run each discovery tick: built-in reads avoid spawning awk/cat per worker.
    IFS= read -r WT_STAT < "/proc/$WT_PID/stat" 2>/dev/null || return 1
    WT_FIELDS=${WT_STAT##*) }
    set -- $WT_FIELDS
    [ "$#" -ge 20 ] || return 1
    shift 19  # starttime is field 22; fields after the final ') ' begin at field 3.
    WT_START=$1
    IFS= read -r WT_BOOT < /proc/sys/kernel/random/boot_id 2>/dev/null || return 1
    case "$WT_START" in ''|*[!0-9]*) return 1 ;; esac
    [ -n "$WT_BOOT" ] && kill -0 "$WT_PID" 2>/dev/null || return 1
    printf '%s:%s:%s\n' "$WT_PID" "$WT_START" "$WT_BOOT"
}

worker_token_is_live() {
    [ -n "$1" ] && [ "$(worker_token "${1%%:*}")" = "$1" ]
}

supervisor_is_live() {
    [ "$(readlink "$LOAD_LOCK" 2>/dev/null)" = "$SUPERVISOR_PID" ] \
        && worker_token_is_live "$SUPERVISOR_TOKEN"
}

# A killed worker may leave its timeout/injector child alive. Do not touch that lane's logs or
# retry record until it is gone, even if the old worker lock itself is stale. Normal cycles never
# pay this scan: it runs only when a replacement worker tries to acquire its lane.
lane_injector_is_live() {
    case "$WORKER_LANE" in
        steering) WI_SCRIPT=$SWK ;;
        multidisplay) WI_SCRIPT=$MD ;;
        launcher) WI_SCRIPT=$LNCH ;;
        vd) WI_SCRIPT=$VD ;;
        apollo) WI_SCRIPT=$APOLLO ;;
        keyboard) WI_SCRIPT=keyboard_ ;;
        apps) WI_SCRIPT=$APP_CLIENT ;;
        *) return 1 ;;
    esac
    for WI_PID in $(pidof frida-inject 2>/dev/null); do
        WI_CMD=$(tr '\000' ' ' < "/proc/$WI_PID/cmdline" 2>/dev/null)
        case "$WI_CMD" in *"$WI_SCRIPT"*) return 0 ;; esac
    done
    return 1
}

acquire_worker_lock() {
    while supervisor_is_live; do
        WL_PREVIOUS=$(readlink "$WORKER_LOCK" 2>/dev/null)
        if ! worker_token_is_live "$WL_PREVIOUS" && ! lane_injector_is_live; then
            # Only the supervisor's single child for this lane performs stale-owner cleanup.
            if [ -n "$WL_PREVIOUS" ] \
                    && [ "$(readlink "$WORKER_LOCK" 2>/dev/null)" = "$WL_PREVIOUS" ]; then
                rm -f "$WORKER_LOCK"
            fi
            if ln -s "$WORKER_TOKEN" "$WORKER_LOCK" 2>/dev/null; then
                return 0
            fi
        fi
        sleep "$WATCHDOG_CYCLE_SECONDS"
    done
    return 1
}

# Small atomic snapshots are the only state shared between lanes. No child-shell variable is
# expected to propagate to its parent. Repeated unchanged states cause no disk write or log spam.
write_worker_state() {
    WS_VALUE="$WORKER_TOKEN|$1|${2:-0}|${3:-none}|${4:-unknown}"
    [ "${WS_LAST_VALUE:-}" != "$WS_VALUE" ] || return 0
    WS_TMP="$WORKER_PREFIX.$WORKER_LANE.state.$$.new"
    if printf '%s\n' "$WS_VALUE" > "$WS_TMP" \
            && mv -f "$WS_TMP" "$WORKER_PREFIX.$WORKER_LANE.state"; then
        WS_LAST_VALUE=$WS_VALUE
        logi "hook lane=$WORKER_LANE state=$1 pid=${2:-0} uptime=$(uptime_seconds)"
    else
        rm -f "$WS_TMP"
    fi
}

read_worker_state() {
    RS_STATE=waiting; RS_SECOND=unknown; RS_PID=0
    RS_TOKEN=; RS_SAVED_STATE=; RS_SAVED_PID=; RS_ID=; RS_SAVED_SECOND=
    [ -r "$WORKER_PREFIX.$1.state" ] || return 0
    IFS='|' read -r RS_TOKEN RS_SAVED_STATE RS_SAVED_PID RS_ID RS_SAVED_SECOND \
        < "$WORKER_PREFIX.$1.state" || return 0
    [ "$(readlink "$WORKER_PREFIX.$1.lock" 2>/dev/null)" = "$RS_TOKEN" ] \
        && worker_token_is_live "$RS_TOKEN" || return 0
    case "$RS_SAVED_PID" in ''|*[!0-9]*) return 0 ;; esac
    # A target may have died since its worker published active. Never present the old PID as ready.
    if [ "$RS_SAVED_PID" != 0 ]; then
        [ "$(process_identity "$RS_SAVED_PID" "$2" 2>/dev/null)" = "$RS_ID" ] || return 0
    fi
    RS_STATE=$RS_SAVED_STATE; RS_SECOND=$RS_SAVED_SECOND; RS_PID=$RS_SAVED_PID
}

collect_worker_states() {
    read_worker_state steering com.qinggan.keymanager.service
    SWK_STATE=$RS_STATE; KMP=$RS_PID
    read_worker_state multidisplay com.qinggan.systemservice
    MD_STATE=$RS_STATE; MDP=$RS_PID
    read_worker_state launcher com.qinggan.app.launcher
    LNCH_STATE=$RS_STATE; LP=$RS_PID
    read_worker_state vd system_server
    VD_STATE=$RS_STATE; SS=$RS_PID
    read_worker_state apollo "$APOLLO_TARGET"
    APOLLO_STATE=$RS_STATE; APOLLO_PID=$RS_PID
    read_worker_state keyboard "$KEYBOARD_TARGET"
    KEYBOARD_EN_STATE=$RS_STATE; KEYBOARD_RU_STATE=$RS_SECOND; KEYBOARD_PID=$RS_PID
}

cleanup_worker() {
    # Finish status publication before releasing its lane to a replacement supervisor.
    if [ "$WORKER_LANE" = status ] && ! supervisor_is_live; then
        collect_worker_states
        publish_hook_status stopped
    fi
    [ "$(readlink "$WORKER_LOCK" 2>/dev/null)" != "$WORKER_TOKEN" ] \
        || rm -f "$WORKER_LOCK"
}

run_worker() {
    WORKER_LANE=$1
    SUPERVISOR_TOKEN=$2
    SUPERVISOR_PID=${SUPERVISOR_TOKEN%%:*}
    case " $WORKER_LANES " in *" $WORKER_LANE "*) ;; *) return 1 ;; esac
    WORKER_TOKEN=$(worker_token "$$") || return 1
    WORKER_LOCK="$WORKER_PREFIX.$WORKER_LANE.lock"
    acquire_worker_lock || return 1
    trap 'cleanup_worker' 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    WORKER_INTERVAL=$WATCHDOG_CYCLE_SECONDS
    case "$WORKER_LANE" in
        apollo|keyboard|apps|status) WORKER_INTERVAL=$OPTIONAL_CYCLE_SECONDS ;;
    esac
    while supervisor_is_live; do
        case "$WORKER_LANE" in
            steering) steering_cycle ;;
            multidisplay) multidisplay_cycle ;;
            launcher) launcher_cycle ;;
            vd) vd_cycle ;;
            apollo) apollo_cycle ;;
            keyboard) keyboard_cycle ;;
            apps) discover_app_client ;;
            status) collect_worker_states; publish_hook_status running ;;
        esac
        sleep "$WORKER_INTERVAL"
    done
}

# Supervision never calls Android Binder or waits for an injection. Child tokens also cover the
# fork-to-lock-publication gap, so a slow-starting shell cannot produce duplicate lane workers.
supervise_workers() {
    NEXT_WORKER_CHILDREN=
    for LANE in $WORKER_LANES; do
        CHILD_TOKEN=
        for CHILD_RECORD in ${WORKER_CHILDREN:-}; do
            [ "${CHILD_RECORD%%|*}" != "$LANE" ] || CHILD_TOKEN=${CHILD_RECORD#*|}
        done
        if ! worker_token_is_live "$CHILD_TOKEN"; then
            [ -z "$CHILD_TOKEN" ] || wait "${CHILD_TOKEN%%:*}" 2>/dev/null
            sh "$0" --worker "$LANE" "$SUPERVISOR_TOKEN" &
            CHILD_PID=$!
            CHILD_TOKEN=$(worker_token "$CHILD_PID") || CHILD_TOKEN=
        fi
        [ -z "$CHILD_TOKEN" ] \
            || NEXT_WORKER_CHILDREN="$NEXT_WORKER_CHILDREN $LANE|$CHILD_TOKEN"
    done
    WORKER_CHILDREN=$NEXT_WORKER_CHILDREN
}

if [ "${1:-}" = --worker ]; then
    run_worker "${2:-}" "${3:-}"
    exit $?
fi

acquire_load_lock
SUPERVISOR_TOKEN=$(worker_token "$$") || exit 1
SUPERVISOR_PID=$$
logi "voyah load.bin start (parallel workers) uptime=$(uptime_seconds)"
while [ 1 ]; do
    supervise_workers
    sleep "$WATCHDOG_CYCLE_SECONDS"
done
