#!/system/bin/sh
# Самодостаточный Frida-оркестратор Open Voyah (не зависит от сторонних обвязок).
# Держит хуки через watchdog-цикл:
#   1) vd_bypass.js          в system_server — trusted VirtualDisplay + инъекция ввода (VD-сплит) + freeform;
#   2) steeringwheelkeys.js  в com.qinggan.keymanager.service — кнопки руля (звёздочка 3090, DVR 173, медиа);
#   3) launcherdock.js       в процессе лаунчера — переопределение дока главного экрана (NavigationBarMain);
#   4) multidisplay.js       в com.qinggan.systemservice — перенос любого приложения между экранами.
#   5) apollo_tech.js        в com.qinggan.app.vehiclesetting — одноразовый explicit legacy attach
#      при старте loader; вечный watchdog Apollo намеренно не опрашивает.
#
# НАДЁЖНОСТЬ ИНЪЕКЦИИ (важно!):
#   • system_server и launcher: frida-inject -e ВОЗВРАЩАЕТ управление. Ставим по ТОЧНОМУ -p pid и пишем
#     pid-маркер ТОЛЬКО ЕСЛИ frida-inject не сообщил об ошибке (нет 'not found'/'unable to find'/…). Если
#     инъекция не удалась (гонка на буте — процесс ещё поднимается) → маркер НЕ трогаем → следующая
#     итерация (10с) повторит с уже готовым процессом. Раньше маркер писался безусловно в фоне, поэтому
#     разовый промах ('Process not found') НЕ повторялся и launcherdock молча не грузился после ребута.
#   • keymanager: тут frida-inject -e иногда ЗАВИСАЕТ (не возвращает управление). Запускаем одну
#     фоновую попытку на PID под timeout; успех подтверждаем exit-code либо точным лог-маркером агента.

LOG_TAG="vt_load_bin"

logi() { log -p i -t $LOG_TAG "$1"; }
loge() { log -p e -t $LOG_TAG "$1"; }

# Atomic owner lock without a mkdir/pid publication gap and without relying on `flock`
# being present in the target ROM. A new path avoids a takeover race with the legacy
# directory lock: the legacy path is only inspected, never removed before v2 is owned.
LEGACY_LOAD_LOCK=/data/local/tmp/voyah_load.lock
LOAD_LOCK=/data/local/tmp/voyah_load.v2.lock

loader_pid_is_live() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$1" 2>/dev/null \
        && tr '\000' ' ' < "/proc/$1/cmdline" 2>/dev/null \
            | grep -q 'local/bin/load.bin'
}

legacy_load_owner() {
    if [ -d "$LEGACY_LOAD_LOCK" ] && [ ! -L "$LEGACY_LOAD_LOCK" ]; then
        cat "$LEGACY_LOAD_LOCK/pid" 2>/dev/null
    elif [ -L "$LEGACY_LOAD_LOCK" ]; then
        readlink "$LEGACY_LOAD_LOCK" 2>/dev/null
    fi
}

LEGACY_LOAD_OWNER=$(legacy_load_owner)
loader_pid_is_live "$LEGACY_LOAD_OWNER" && exit 0

while [ 1 ]; do
    if ln -s "$$" "$LOAD_LOCK" 2>/dev/null; then
        LOAD_LOCK_OWNER=$$
        break
    fi

    LOAD_LOCK_OWNER=$(readlink "$LOAD_LOCK" 2>/dev/null)
    loader_pid_is_live "$LOAD_LOCK_OWNER" && exit 0

    # Remove only the stale owner we inspected; if another loader won the race,
    # its different PID target is left intact.
    if [ -L "$LOAD_LOCK" ]; then
        [ "$(readlink "$LOAD_LOCK" 2>/dev/null)" = "$LOAD_LOCK_OWNER" ] \
            && rm -f "$LOAD_LOCK"
    elif [ -e "$LOAD_LOCK" ]; then
        # Миграция с legacy regular-file lock.
        rm -f "$LOAD_LOCK"
    fi
done

cleanup_load_lock() {
    [ "$(readlink "$LOAD_LOCK" 2>/dev/null)" = "$$" ] && rm -f "$LOAD_LOCK"
}

# У trapped signal default termination заменяется handler'ом, поэтому handler обязан вызвать exit.
trap 'cleanup_load_lock' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# An old loader could have acquired the legacy directory during an in-place update.
# Recheck after winning v2; EXIT cleanup releases only our own v2 symlink.
LEGACY_LOAD_OWNER=$(legacy_load_owner)
loader_pid_is_live "$LEGACY_LOAD_OWNER" && exit 0

FI=/data/local/bin/frida-inject
VD=/data/local/bin/vd_bypass.js
SWK=/data/local/bin/steeringwheelkeys.js
LNCH=/data/local/bin/launcherdock.js
MD=/data/local/bin/multidisplay.js
APOLLO=/data/local/bin/apollo_tech.js
VDMARK=/data/local/tmp/voyah_vd.pid          # pid system_server, куда поставлен vd_bypass
SWK_KM_MARK=/data/local/tmp/voyah_swk_km.pid # pid keymanager, куда поставлен steeringwheelkeys
SWK_KM_BUSY=/data/local/tmp/voyah_swk_km.busy # symlink: targetPid|startUptime|token
SWK_KM_BUSY_TTL=45                            # timeout 30s + 5s KILL + запас на cleanup
LNCH_MARK=/data/local/tmp/voyah_lnch.pid     # pid лаунчера, куда поставлен launcherdock
MD_MARK=/data/local/tmp/voyah_md.pid         # pid systemservice, куда поставлен multidisplay
APOLLO_MARK=/data/local/tmp/voyah_apollo.pid # v2|boot_uuid|pid|starttime exact Apollo agent identity
APOLLO_DOWN_MARK=/data/local/tmp/voyah_apollo.down
APOLLO_LOG=/data/local/tmp/voyah_apollo.txt
APOLLO_TARGET=com.qinggan.app.vehiclesetting
APOLLO_READY_MARKER='[apollo] hook ready'
APOLLO_LEGACY_OPT_IN_KEY=open_voyah_apollo_legacy_hook_enabled
APOLLO_DISABLED_MARK=/data/local/tmp/voyah_apollo.disabled
APOLLO_SETTINGS_TIMEOUT=5
APOLLO_FORCE_STOP_TIMEOUT=10

apollo_settings_get() {
    timeout -k 2 "$APOLLO_SETTINGS_TIMEOUT" settings get global "$1" 2>/dev/null
}

apollo_settings_put_zero() {
    timeout -k 2 "$APOLLO_SETTINGS_TIMEOUT" settings put global "$1" 0 >/dev/null 2>&1
}

apollo_force_stop_target() {
    timeout -k 2 "$APOLLO_FORCE_STOP_TIMEOUT" am force-stop "$APOLLO_TARGET" \
        >/dev/null 2>&1
}

reset_apollo_liveness() {
    # Оба сброса независимы: отказ первого не должен мешать попытке обнулить второй ключ. Legacy
    # heartbeat пишем первым, чтобы потребитель перестал доверять stale profile=1 как можно раньше.
    # Этот primitive сам readback не делает: direct-only cleanup ниже проверяет одной bounded фазой
    # все три записанных ключа, а новая legacy-инъекция подтверждается exact agent-ready marker.
    APOLLO_RESET_OK=1
    apollo_settings_put_zero open_voyah_apollo_profile_heartbeat \
        || APOLLO_RESET_OK=0
    apollo_settings_put_zero open_voyah_apollo_profile_supported \
        || APOLLO_RESET_OK=0
    [ "$APOLLO_RESET_OK" -eq 1 ]
}

verify_apollo_liveness_reset() {
    APOLLO_VERIFY_OK=1
    APOLLO_VERIFY_PROFILE=$(apollo_settings_get open_voyah_apollo_profile_supported) \
        || APOLLO_VERIFY_OK=0
    APOLLO_VERIFY_HEARTBEAT=$(apollo_settings_get open_voyah_apollo_profile_heartbeat) \
        || APOLLO_VERIFY_OK=0
    [ "$APOLLO_VERIFY_PROFILE" = "0" ] || APOLLO_VERIFY_OK=0
    [ "$APOLLO_VERIFY_HEARTBEAT" = "0" ] || APOLLO_VERIFY_OK=0
    [ "$APOLLO_VERIFY_OK" -eq 1 ]
}

# Direct-only релиз не использует VehicleSetting/Frida profile. При отсутствии
# точного opt-in закрываем и master, и публикуемый legacy-profile. Если marker
# доказывает, что агент живёт в текущей process identity, force-stop однократно
# выгружает eternalized hook. Чужой/протухший PID процесс не затрагивает.
disable_apollo_legacy_hook() {
    # Сначала фиксируем ownership proof. Даже полный отказ Settings не должен перескочить выгрузку
    # exact-owned eternalized agent. Нечитаемая identity остаётся unresolved: такой marker нельзя ни
    # использовать для force-stop, ни объявлять успешно очищенным.
    APOLLO_ATTACHED_ID=$(cat "$APOLLO_MARK" 2>/dev/null)
    APOLLO_DISABLE_PID=
    APOLLO_DISABLE_ID=
    APOLLO_MARKER_KEEP=0
    APOLLO_EXACT_AGENT=0
    if [ -n "$APOLLO_ATTACHED_ID" ]; then
        APOLLO_DISABLE_PID=$(pidof "$APOLLO_TARGET" 2>/dev/null)
        APOLLO_DISABLE_PID=${APOLLO_DISABLE_PID%% *}
        if [ -n "$APOLLO_DISABLE_PID" ]; then
            APOLLO_DISABLE_ID=$(target_identity \
                "$APOLLO_DISABLE_PID" "$APOLLO_TARGET" 2>/dev/null)
            if [ -z "$APOLLO_DISABLE_ID" ]; then
                APOLLO_MARKER_KEEP=1
            elif [ "$APOLLO_ATTACHED_ID" = "$APOLLO_DISABLE_ID" ]; then
                APOLLO_EXACT_AGENT=1
                APOLLO_MARKER_KEEP=1
            fi
        fi
    fi

    APOLLO_DISABLE_OK=1
    rm -f "$APOLLO_DISABLED_MARK" || APOLLO_DISABLE_OK=0
    if [ "$APOLLO_EXACT_AGENT" -eq 1 ]; then
        # Revalidate immediately before the package-level stop. In particular, do this before the
        # three bounded Settings writes: their latency must never let a replaced clean process inherit
        # the old ownership proof. A changed identity is stale metadata and is never force-stopped.
        APOLLO_PRE_STOP_ID=$(target_identity \
            "$APOLLO_DISABLE_PID" "$APOLLO_TARGET" 2>/dev/null)
        if [ "$APOLLO_PRE_STOP_ID" = "$APOLLO_DISABLE_ID" ]; then
            # Command status alone is not authoritative: if the exact identity has already disappeared,
            # cleanup succeeded even when `am` raced with process death. A still-live exact identity
            # keeps its marker and makes the one-shot cleanup fail closed.
            apollo_force_stop_target || :
            APOLLO_AFTER_STOP_ID=$(target_identity \
                "$APOLLO_DISABLE_PID" "$APOLLO_TARGET" 2>/dev/null)
            if [ "$APOLLO_AFTER_STOP_ID" = "$APOLLO_DISABLE_ID" ]; then
                APOLLO_DISABLE_OK=0
            elif kill -0 "$APOLLO_DISABLE_PID" 2>/dev/null \
                    && [ -z "$APOLLO_AFTER_STOP_ID" ]; then
                # PID всё ещё существует, но exact identity после stop прочитать не удалось.
                APOLLO_DISABLE_OK=0
            else
                APOLLO_MARKER_KEEP=0
            fi
        elif kill -0 "$APOLLO_DISABLE_PID" 2>/dev/null \
                && [ -z "$APOLLO_PRE_STOP_ID" ]; then
            # Живой PID с нечитаемой identity нельзя ни убивать, ни объявлять очищенным.
            APOLLO_DISABLE_OK=0
        else
            # Saved identity уже исчезла или сменилась: новый процесс не трогаем, старый marker stale.
            APOLLO_MARKER_KEEP=0
        fi
    elif [ "$APOLLO_MARKER_KEEP" -eq 1 ]; then
        APOLLO_DISABLE_OK=0
    fi

    # Settings cleanup остаётся независимым и выполняется даже после неуспешного stop/ownership
    # revalidation. AOSP SettingsCmd может напечатать RemoteException и всё равно завершиться с 0,
    # поэтому после всех трёх put делаем ровно одну bounded verification-фазу. Это startup cleanup,
    # не часть вечного watchdog.
    apollo_settings_put_zero open_voyah_apollo_master \
        || APOLLO_DISABLE_OK=0
    reset_apollo_liveness || APOLLO_DISABLE_OK=0
    APOLLO_DISABLE_MASTER=$(apollo_settings_get open_voyah_apollo_master) \
        || APOLLO_DISABLE_OK=0
    [ "$APOLLO_DISABLE_MASTER" = "0" ] || APOLLO_DISABLE_OK=0
    verify_apollo_liveness_reset || APOLLO_DISABLE_OK=0

    if [ "$APOLLO_MARKER_KEEP" -eq 0 ]; then
        rm -f "$APOLLO_MARK" || APOLLO_DISABLE_OK=0
    fi
    rm -f "$APOLLO_DOWN_MARK" || APOLLO_DISABLE_OK=0

    [ "$APOLLO_DISABLE_OK" -eq 1 ] || return 1
    APOLLO_DISABLED_TMP="$APOLLO_DISABLED_MARK.$$"
    if ! echo 1 > "$APOLLO_DISABLED_TMP" \
            || ! mv -f "$APOLLO_DISABLED_TMP" "$APOLLO_DISABLED_MARK"; then
        rm -f "$APOLLO_DISABLED_TMP"
        return 1
    fi
    return 0
}

# Инъекция в цель, которая ВОЗВРАЩАЕТ управление. Маркер пишем ТОЛЬКО при успехе.
#   $1=pid  $2=script  $3=logfile  $4=markerfile
inject_ret() {
    TRY="$3.try"
    : > "$TRY"
    timeout -k 5 30 "$FI" -p "$1" -s "$2" -e > "$TRY" 2>&1
    RC=$?
    cat "$TRY" >> "$3"
    if [ "$RC" -ne 0 ]; then
        loge "inject FAIL pid=$1 $2 rc=$RC (retry next loop)"
        return 1
    fi
    # Ошибки самого frida-inject (агент пишет свои сообщения через console.log/Log — их НЕ матчим).
    if grep -qiE 'unable to find|not found|failed to|cannot parse|no such process|error resolving' "$TRY"; then
        loge "inject FAIL pid=$1 $2 (retry next loop)"
        return 1
    fi
    echo "$1" > "$4"
    logi "inject OK pid=$1 $2"
    return 0
}

# Монотонные секунды с boot; после reboot старый timestamp автоматически выглядит протухшим.
uptime_seconds() {
    UPTIME_NOW=$(cut -d. -f1 /proc/uptime 2>/dev/null)
    case "$UPTIME_NOW" in
        ''|*[!0-9]*) date +%s ;;
        *) echo "$UPTIME_NOW" ;;
    esac
}

# Точная идентичность процесса: проверяем cmdline (не только число PID) и добавляем starttime из
# /proc/<pid>/stat. Это исключает ложный «уже установлен» при повторном использовании старого PID.
# Boot UUID обязателен: starttime отсчитывается заново после reboot, а marker в /data его переживает.
# Prefix v2 не позволяет старому PID|starttime marker стать доказательством для force-stop.
target_identity() {
    IDENT_PID="$1"
    IDENT_NAME="$2"
    case "$IDENT_PID" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$IDENT_PID" 2>/dev/null || return 1
    IDENT_CMD=$(tr '\000' '\n' < "/proc/$IDENT_PID/cmdline" 2>/dev/null | sed -n '1p')
    [ "$IDENT_CMD" = "$IDENT_NAME" ] || return 1
    IDENT_START=$(awk '{print $22}' "/proc/$IDENT_PID/stat" 2>/dev/null)
    case "$IDENT_START" in
        ''|*[!0-9]*) return 1 ;;
    esac
    IDENT_BOOT=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
    case "$IDENT_BOOT" in
        ''|*[!0-9a-fA-F-]*) return 1 ;;
    esac
    echo "v2|$IDENT_BOOT|$IDENT_PID|$IDENT_START"
}

# Apollo требует не просто успешный exit frida-inject, а точный marker самого агента. Идентичность
# цели проверяется до и после attach; marker публикуется атомарным mv только для того же живого процесса.
#   $1=pid $2=target-name $3=script $4=logfile $5=markerfile $6=agent-ready-marker
inject_verified_marker() {
    VERIFIED_PID="$1"
    VERIFIED_TARGET="$2"
    VERIFIED_SCRIPT="$3"
    VERIFIED_LOG="$4"
    VERIFIED_MARK="$5"
    VERIFIED_READY="$6"
    VERIFIED_TRY="$VERIFIED_LOG.try"

    VERIFIED_BEFORE=$(target_identity "$VERIFIED_PID" "$VERIFIED_TARGET") || {
        loge "inject SKIP target changed pid=$VERIFIED_PID $VERIFIED_TARGET"
        return 1
    }

    : > "$VERIFIED_TRY"
    # На VehicleSetting `frida-inject -e` может не завершиться после успешной eternalize. Два pinned
    # SHA-256 на проверенной голове занимают несколько секунд; 30s достаточно, а точный ready-marker
    # агента является критерием успеха даже после штатного timeout/TERM обвязки.
    timeout -k 5 30 "$FI" -p "$VERIFIED_PID" -s "$VERIFIED_SCRIPT" -e > "$VERIFIED_TRY" 2>&1
    VERIFIED_RC=$?
    if [ -f "$VERIFIED_LOG" ]; then
        VERIFIED_LOG_SIZE=$(wc -c < "$VERIFIED_LOG" 2>/dev/null)
    else
        VERIFIED_LOG_SIZE=0
    fi
    case "$VERIFIED_LOG_SIZE" in
        ''|*[!0-9]*) VERIFIED_LOG_SIZE=0 ;;
    esac
    if [ "$VERIFIED_LOG_SIZE" -ge 1048576 ]; then
        mv -f "$VERIFIED_LOG" "$VERIFIED_LOG.1"
    fi
    {
        echo "event=inject_attempt target=$VERIFIED_TARGET identity=$VERIFIED_BEFORE rc=$VERIFIED_RC"
        cat "$VERIFIED_TRY"
    } >> "$VERIFIED_LOG"

    if grep -qiE 'unable to find|not found|failed to|cannot parse|no such process|error resolving' "$VERIFIED_TRY"; then
        loge "inject FAIL pid=$VERIFIED_PID $VERIFIED_SCRIPT engine-error (explicit loader restart required)"
        return 1
    fi
    if ! grep -qF "$VERIFIED_READY" "$VERIFIED_TRY"; then
        loge "inject FAIL pid=$VERIFIED_PID $VERIFIED_SCRIPT agent-marker-missing (explicit loader restart required)"
        return 1
    fi
    if [ "$VERIFIED_RC" -ne 0 ]; then
        logi "inject READY pid=$VERIFIED_PID $VERIFIED_SCRIPT rc=$VERIFIED_RC marker-confirmed"
    fi

    VERIFIED_AFTER=$(target_identity "$VERIFIED_PID" "$VERIFIED_TARGET") || {
        loge "inject FAIL pid=$VERIFIED_PID $VERIFIED_SCRIPT target-exited (explicit loader restart required)"
        return 1
    }
    if [ "$VERIFIED_AFTER" != "$VERIFIED_BEFORE" ]; then
        loge "inject FAIL pid=$VERIFIED_PID $VERIFIED_SCRIPT target-changed (explicit loader restart required)"
        return 1
    fi

    VERIFIED_MARK_TMP="$VERIFIED_MARK.$$"
    if ! echo "$VERIFIED_AFTER" > "$VERIFIED_MARK_TMP" || ! mv -f "$VERIFIED_MARK_TMP" "$VERIFIED_MARK"; then
        rm -f "$VERIFIED_MARK_TMP"
        loge "inject FAIL pid=$VERIFIED_PID $VERIFIED_SCRIPT marker-write (explicit loader restart required)"
        return 1
    fi
    logi "inject OK pid=$VERIFIED_PID $VERIFIED_SCRIPT marker=$VERIFIED_AFTER"
    return 0
}

# `timeout` uses a clock that may pause in suspend on some Toybox builds, while /proc/uptime can
# advance across suspend. Before expiring a TTL record, verify that its actual injector child is
# gone; otherwise a long sleep could create a second injection while the first still has time left.
keymanager_inject_is_live() {
    for KM_INJECT_PID in $(pidof frida-inject 2>/dev/null); do
        KM_INJECT_CMD=$(tr '\000' ' ' < "/proc/$KM_INJECT_PID/cmdline" 2>/dev/null)
        case "$KM_INJECT_CMD" in
            *"-p $1 "*"steeringwheelkeys.js"*) return 0 ;;
        esac
    done
    return 1
}

# keymanager на части прошивок не возвращает управление после успешного -e. Busy-symlink создаётся
# атомарно и представляет ГЛОБАЛЬНУЮ single-flight попытку (не только попытку на конкретный target PID).
# Если worker был убит до cleanup, TTL освобождает stale busy после гарантированного TERM->KILL окна.
inject_keymanager_bg() {
    KM_TARGET_PID="$1"
    while [ 1 ]; do
        KM_NOW=$(uptime_seconds)
        KM_BUSY_RECORD=$(readlink "$SWK_KM_BUSY" 2>/dev/null)

        if [ -L "$SWK_KM_BUSY" ]; then
            KM_BUSY_TARGET=${KM_BUSY_RECORD%%|*}
            KM_BUSY_REST=${KM_BUSY_RECORD#*|}
            KM_BUSY_STARTED=${KM_BUSY_REST%%|*}
            case "$KM_NOW" in
                ''|*[!0-9]*) KM_BUSY_AGE=$SWK_KM_BUSY_TTL ;;
                *)
                    case "$KM_BUSY_STARTED" in
                        ''|*[!0-9]*) KM_BUSY_AGE=$SWK_KM_BUSY_TTL ;;
                        *) KM_BUSY_AGE=$((KM_NOW - KM_BUSY_STARTED)) ;;
                    esac
                    ;;
            esac
            if [ "$KM_BUSY_AGE" -ge 0 ] && [ "$KM_BUSY_AGE" -lt "$SWK_KM_BUSY_TTL" ]; then
                return 0
            fi
            if keymanager_inject_is_live "$KM_BUSY_TARGET"; then
                logi "keep keymanager injection busy: live injector pid target=$KM_BUSY_TARGET"
                return 0
            fi
            logi "clear stale keymanager injection busy age=${KM_BUSY_AGE}s record=$KM_BUSY_RECORD"
            # Один loader владеет owner-lock; conditional read защищает от cleanup завершившегося worker.
            [ "$(readlink "$SWK_KM_BUSY" 2>/dev/null)" = "$KM_BUSY_RECORD" ] \
                && rm -f "$SWK_KM_BUSY"
            continue
        elif [ -e "$SWK_KM_BUSY" ]; then
            # Миграция с legacy regular-file busy (там лежал только target PID).
            logi "clear legacy keymanager injection busy"
            rm -f "$SWK_KM_BUSY"
            continue
        fi

        KM_TOKEN="$$.$KM_NOW.$KM_TARGET_PID"
        KM_RECORD="$KM_TARGET_PID|$KM_NOW|$KM_TOKEN"
        if ln -s "$KM_RECORD" "$SWK_KM_BUSY" 2>/dev/null; then
            break
        fi
    done

    logi "inject steeringwheelkeys -> keymanager $KM_TARGET_PID (eternalize,bounded-bg)"
    (
        # Не наследуем loader traps: worker живёт не дольше timeout+KILL и сам чистит busy.
        trap - 0 HUP INT TERM
        KM_TRY="/data/local/tmp/voyah_swk.$KM_TOKEN.try"
        : > "$KM_TRY"
        timeout -k 5 30 "$FI" -p "$KM_TARGET_PID" -s "$SWK" -e > "$KM_TRY" 2>&1
        KM_RC=$?
        cat "$KM_TRY" >> /data/local/tmp/voyah_swk.txt
        if grep -qiE 'unable to find|not found|failed to|cannot parse|no such process|error resolving' "$KM_TRY"; then
            loge "inject FAIL keymanager pid=$KM_TARGET_PID rc=$KM_RC (retry next loop)"
        elif [ "$KM_RC" -eq 0 ] || grep -qF '[swk] keymanager hooks installed:' "$KM_TRY"; then
            echo "$KM_TARGET_PID" > "$SWK_KM_MARK"
            logi "inject OK keymanager pid=$KM_TARGET_PID"
        else
            loge "inject FAIL keymanager pid=$KM_TARGET_PID rc=$KM_RC (retry next loop)"
        fi
        rm -f "$KM_TRY"
        [ "$(readlink "$SWK_KM_BUSY" 2>/dev/null)" = "$KM_RECORD" ] \
            && rm -f "$SWK_KM_BUSY"
    ) &
}

apollo_startup_once() {
    # Opt-in читается ровно один раз на весь срок жизни loader. Остальные bounded Settings reads
    # ниже только проверяют startup cleanup/reset; вечный watchdog Apollo-код не запускает. Null,
    # timeout и любое значение кроме точного "1" выбирают fail-closed direct-only cleanup.
    APOLLO_LEGACY_OPT_IN=$(apollo_settings_get "$APOLLO_LEGACY_OPT_IN_KEY")
    if [ "$APOLLO_LEGACY_OPT_IN" != "1" ]; then
        if disable_apollo_legacy_hook; then
            logi "apollo direct-only: one-shot cleanup complete; no runtime polling"
        else
            loge "apollo direct-only: one-shot cleanup incomplete; explicit loader restart required"
        fi
        return
    fi

    # Диагностический legacy attach также одноразовый. Сначала проверяем уже запущенный
    # VehicleSetting по exact process identity; exact already-attached агент оставляем полностью
    # нетронутым. Отсутствие цели/скрипта и любая ошибка не создают retry: оператор готовит свежий
    # target и явно рестартует voyahtune_load.
    APOLLO_STARTUP_OK=1
    rm -f "$APOLLO_DISABLED_MARK" || APOLLO_STARTUP_OK=0
    rm -f "$APOLLO_DOWN_MARK" || APOLLO_STARTUP_OK=0
    if [ "$APOLLO_STARTUP_OK" -ne 1 ]; then
        loge "apollo legacy: stale state cleanup FAIL; explicit loader restart required"
        return
    fi

    APOLLO_PID=$(pidof "$APOLLO_TARGET" 2>/dev/null)
    APOLLO_PID=${APOLLO_PID%% *}
    APOLLO_ID=
    if [ -n "$APOLLO_PID" ]; then
        APOLLO_ID=$(target_identity "$APOLLO_PID" "$APOLLO_TARGET" 2>/dev/null)
    fi
    APOLLO_ATTACHED_ID=$(cat "$APOLLO_MARK" 2>/dev/null)
    if [ -n "$APOLLO_ID" ] && [ "$APOLLO_ATTACHED_ID" = "$APOLLO_ID" ]; then
        logi "apollo legacy: exact agent identity already attached; no duplicate injection"
        return
    fi

    # Во всех active-start исходах, кроме доказанного exact already-attached агента, stale liveness
    # сбрасывается и тут же проверяется. Без вечного Apollo-watchdog отсутствие target иначе могло бы
    # навсегда оставить profile=1 от уже умершего процесса.
    if ! reset_apollo_liveness || ! verify_apollo_liveness_reset; then
        loge "apollo legacy: one-shot liveness reset FAIL; explicit loader restart required"
        return
    fi

    if [ -z "$APOLLO_PID" ]; then
        if rm -f "$APOLLO_MARK"; then
            logi "apollo legacy: VehicleSetting is not running; open a fresh target and restart loader"
        else
            loge "apollo legacy: stale marker cleanup FAIL; explicit loader restart required"
        fi
        return
    fi
    if [ -z "$APOLLO_ID" ]; then
        loge "apollo legacy: VehicleSetting identity unavailable; explicit loader restart required"
        return
    fi

    if ! rm -f "$APOLLO_MARK"; then
        loge "apollo legacy: stale marker cleanup FAIL; explicit loader restart required"
        return
    fi
    if [ ! -f "$APOLLO" ]; then
        loge "apollo legacy: script missing; explicit loader restart required"
        return
    fi

    inject_verified_marker "$APOLLO_PID" "$APOLLO_TARGET" "$APOLLO" \
        "$APOLLO_LOG" "$APOLLO_MARK" "$APOLLO_READY_MARKER" \
        || loge "apollo legacy: one-shot attach failed; explicit loader restart required"
}

watchdog_cycle() {
    # 1) VD-хук + freeform в system_server (возвращает управление → verify-before-mark)
    SS=$(pidof system_server)
    if [ -n "$SS" ] && [ -f "$VD" ]; then
        if [ "$(cat "$VDMARK" 2>/dev/null)" != "$SS" ]; then
            inject_ret "$SS" "$VD" /data/local/tmp/voyah_vd_bypass.txt "$VDMARK"
        fi
    fi

    # 2) Переопределение дока — инъекция в процесс лаунчера (возвращает управление → verify-before-mark).
    #    По -p pid (точнее -n, устойчивее к гонке имени на буте). При промахе повтор на след. итерации.
    LP=$(pidof com.qinggan.app.launcher)
    if [ -n "$LP" ] && [ -f "$LNCH" ]; then
        if [ "$(cat "$LNCH_MARK" 2>/dev/null)" != "$LP" ]; then
            inject_ret "$LP" "$LNCH" /data/local/tmp/voyah_lnch.txt "$LNCH_MARK"
        fi
    fi

    # 3) Кнопки руля в keymanager: фоновая, но bounded/verified попытка (см. inject_keymanager_bg).
    KMP=$(pidof com.qinggan.keymanager.service 2>/dev/null)
    KMP=${KMP%% *}
    if [ -n "$KMP" ] && [ -f "$SWK" ]; then
        if [ "$(cat "$SWK_KM_MARK" 2>/dev/null)" != "$KMP" ]; then
            inject_keymanager_bg "$KMP"
        fi
    fi

    # 4) Перенос приложений между экранами — инъекция в systemservice (возвращает управление →
    #    verify-before-mark, как system_server и лаунчер).
    MDP=$(pidof com.qinggan.systemservice)
    if [ -n "$MDP" ] && [ -f "$MD" ]; then
        if [ "$(cat "$MD_MARK" 2>/dev/null)" != "$MDP" ]; then
            inject_ret "$MDP" "$MD" /data/local/tmp/voyah_md.txt "$MD_MARK"
        fi
    fi
}

logi "voyah load.bin start"
apollo_startup_once

while [ 1 ]; do
    watchdog_cycle
    sleep 10
done
