# voyahtune.load.rc — Open Voyah: запуск Frida-оркестратора (load.bin) своим init-сервисом.
# Раньше это делал init.logcat.sh (монки-патч штатного скрипта логирования). load.bin —
# watchdog-цикл сам по себе, поэтому НЕ oneshot: init перезапустит сервис, если он упадёт.
# disabled + property-триггер даёт property-gated ordering: сервис не стартует раньше, чем
# voyahtune.setenforce.rc успеет выставить permissive, и не раньше boot_completed (когда
# install.sh уже гарантированно наполнил /data/local/bin).
service voyahtune_load /system/bin/sh /system/etc/init.voyahtune.load.sh
    class late_start
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start voyahtune_load
