<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/surface">
    <LinearLayout android:layout_width="224dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/sidebar">
        <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VoyahTune" android:textSize="26sp" android:fontFamily="sans-medium"/>
        <TextView style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Обновления" android:textSize="16sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="42dp">
            <TextView android:id="@+id/nav0" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="①  Новый релиз"/>
            <TextView android:id="@+id/nav1" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="②  Скачивание"/>
            <TextView android:id="@+id/nav2" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="③  Установка"/>
            <TextView android:id="@+id/nav3" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="④  Готово"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
        <TextView android:id="@+id/service" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Подключение…" android:textSize="15sp"/>
        <TextView android:id="@+id/installed" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Установлено: —" android:textSize="15sp"/>
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:paddingHorizontal="28dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Обновление VoyahTune" android:textSize="22sp" android:fontFamily="sans-medium"/>
            <ImageButton android:id="@+id/settings" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/button_secondary" android:src="@drawable/ic_settings" android:contentDescription="Настройки обновлений"/>
            <Button android:id="@+id/back" style="@style/ActionButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginLeft="12dp" android:text="‹  В VoyahTune"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1.62" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/eyebrow" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/teal" android:textSize="13sp" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/title" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="32sp" android:fontFamily="sans-medium" android:accessibilityLiveRegion="polite"/>
                    <TextView android:id="@+id/subtitle" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="3dp"/>
                    <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="24dp" android:orientation="vertical" android:background="@drawable/card">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/release" style="@style/BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="26sp" android:fontFamily="sans-medium"/>
                            <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:padding="8dp" android:background="@drawable/badge" android:textColor="@color/teal" android:textSize="14sp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/meta" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp"/>
                        <TextView android:id="@+id/detail" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="16sp" android:textIsSelectable="true"/>
                        <LinearLayout android:id="@+id/meter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView android:id="@+id/progress_label" style="@style/BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/percent" style="@style/BodyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:textColor="@color/teal" android:textSize="28sp"/>
                            </LinearLayout>
                            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:progressTint="@color/teal" android:indeterminateTint="@color/teal" android:progressBackgroundTint="@color/line" android:max="100"/>
                            <TextView android:id="@+id/progress_note" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="26dp" android:orientation="vertical">
                    <TextView android:id="@+id/aside_title" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:fontFamily="sans-medium"/>
                    <TextView android:id="@+id/aside_text" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:lineSpacingExtra="5dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:paddingHorizontal="28dp" android:paddingVertical="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/footer_note" style="@style/MutedText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginRight="18dp" android:textSize="16sp"/>
            <Button android:id="@+id/secondary" style="@style/ActionButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="Проверить снова"/>
            <Button android:id="@+id/primary" style="@style/PrimaryButton" android:layout_width="wrap_content" android:minWidth="216dp" android:layout_height="56dp" android:layout_marginLeft="12dp" android:text="Проверить обновления"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
