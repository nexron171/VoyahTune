<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/surface">
    <LinearLayout android:layout_width="300dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
        <ImageButton android:id="@+id/back" android:layout_width="72dp" android:layout_height="72dp" android:padding="20dp" android:background="@drawable/back_background" android:src="@drawable/ic_back" android:contentDescription="В VoyahTune"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="24dp" android:orientation="vertical">
            <TextView android:id="@+id/nav0" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="①  Новый релиз" android:textSize="23sp"/>
            <TextView android:id="@+id/nav1" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="②  Скачивание" android:textSize="23sp"/>
            <TextView android:id="@+id/nav2" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="③  Установка" android:textSize="23sp"/>
            <TextView android:id="@+id/nav3" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="④  Готово" android:textSize="23sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
        <TextView android:id="@+id/service" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Подключение…" android:textSize="15sp"/>
        <TextView android:id="@+id/installed" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Установлено: —" android:textSize="15sp"/>
    </LinearLayout>
    <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#303947"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:clipToPadding="false" android:scrollbars="none" android:descendantFocusability="beforeDescendants" android:focusableInTouchMode="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="28dp" android:paddingTop="132dp" android:paddingBottom="28dp" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1.62" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="168dp" android:padding="25dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/update_intro">
                            <ImageView android:id="@+id/hero_icon" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="24dp" android:padding="17dp" android:background="@drawable/icon_background" android:src="@drawable/ic_download" android:importantForAccessibility="no"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:id="@+id/eyebrow" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/teal" android:textSize="13sp" android:letterSpacing="0.1"/>
                                <TextView android:id="@+id/title" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="32sp" android:fontFamily="@font/updater_arimo_bold" android:accessibilityLiveRegion="polite"/>
                                <TextView android:id="@+id/subtitle" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="18sp" android:lineSpacingMultiplier="1.45"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="25dp" android:orientation="vertical" android:background="@drawable/card">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView android:id="@+id/release" style="@style/BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="26sp"/>
                                <TextView android:id="@+id/badge" style="@style/BodyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:background="@drawable/badge" android:textColor="@color/teal" android:textSize="14sp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/meta" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="17sp"/>
                            <TextView android:id="@+id/detail" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:lineSpacingMultiplier="1.5" android:textIsSelectable="true"/>
                            <LinearLayout android:id="@+id/meter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                    <TextView android:id="@+id/progress_label" style="@style/BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="20sp"/>
                                    <TextView android:id="@+id/percent" style="@style/BodyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/teal" android:textSize="32sp"/>
                                </LinearLayout>
                                <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:progressDrawable="@drawable/update_progress" android:progressTint="@color/teal" android:indeterminateTint="@color/teal" android:progressBackgroundTint="@color/line" android:max="100"/>
                                <TextView android:id="@+id/progress_note" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:lineSpacingMultiplier="1.4"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:padding="25dp" android:orientation="vertical" android:background="@drawable/card">
                        <ImageView android:id="@+id/aside_icon" android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:background="@drawable/icon_background" android:src="@drawable/ic_shield" android:importantForAccessibility="no"/>
                        <TextView style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="ПРИ ОБНОВЛЕНИИ" android:textSize="13sp" android:letterSpacing="0.1"/>
                        <TextView android:id="@+id/aside_title" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="24sp"/>
                        <TextView android:id="@+id/aside_text" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="18sp" android:lineSpacingMultiplier="1.55"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="113dp" android:paddingHorizontal="28dp" android:paddingTop="24dp" android:paddingBottom="24dp" android:orientation="horizontal" android:elevation="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="СИСТЕМА" android:textColor="@color/eyebrow" android:textSize="12sp" android:letterSpacing="0.208" android:fontFamily="@font/updater_arimo_bold"/>
                    <TextView android:id="@+id/header_title" style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Обновления VoyahTune" android:textSize="36sp" android:fontFamily="@font/updater_arimo_bold"/>
                </LinearLayout>
                <ImageButton android:id="@+id/settings" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="16dp" android:padding="18dp" android:background="@drawable/button_secondary" android:src="@drawable/ic_settings" android:contentDescription="Настройки обновлений"/>
            </LinearLayout>
        </FrameLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#303947"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="100dp" android:paddingHorizontal="28dp" android:paddingVertical="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/footer_note" style="@style/MutedText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:textSize="16sp" android:lineSpacingMultiplier="1.45"/>
            <Button android:id="@+id/secondary" style="@style/ActionButton" android:layout_width="wrap_content" android:layout_height="64dp" android:text="Проверить снова"/>
            <Button android:id="@+id/primary" style="@style/PrimaryButton" android:layout_width="wrap_content" android:minWidth="280dp" android:layout_height="64dp" android:layout_marginStart="16dp" android:text="Проверить обновления"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
