<resources>
    <style name="UpdaterTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="BodyText"><item name="android:textColor">@color/ink</item><item name="android:textSize">18sp</item><item name="android:fontFamily">sans</item></style>
    <style name="MutedText" parent="BodyText"><item name="android:textColor">@color/muted</item></style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/ink</item><item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item><item name="android:minHeight">56dp</item>
        <item name="android:paddingLeft">22dp</item><item name="android:paddingRight">22dp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PrimaryButton" parent="ActionButton"><item name="android:background">@drawable/button_primary</item><item name="android:textColor">@color/teal_dark</item><item name="android:fontFamily">sans-medium</item></style>
</resources>
