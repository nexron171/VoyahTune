<resources>
    <style name="UpdaterTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/updater_arimo_regular</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/UpdaterDialogTheme</item>
    </style>
    <style name="UpdaterDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/updater_arimo_regular</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:windowBackground">@drawable/card</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowMinWidthMajor">60%</item>
    </style>
    <style name="BodyText"><item name="android:textColor">@color/ink</item><item name="android:textSize">22sp</item><item name="android:fontFamily">@font/updater_arimo_regular</item><item name="android:includeFontPadding">false</item></style>
    <style name="MutedText" parent="BodyText"><item name="android:textColor">@color/muted</item></style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/ink</item><item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/updater_arimo_regular</item><item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item><item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">24dp</item><item name="android:paddingRight">24dp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PrimaryButton" parent="ActionButton"><item name="android:background">@drawable/button_primary</item><item name="android:textColor">@color/teal_dark</item><item name="android:fontFamily">@font/updater_arimo_bold</item><item name="android:textSize">23sp</item></style>
</resources>
