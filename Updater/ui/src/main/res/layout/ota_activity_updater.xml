<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ota_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/ota_surface">
    <LinearLayout android:layout_width="300dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
        <ImageButton android:id="@+id/ota_back" android:layout_width="72dp" android:layout_height="72dp" android:padding="20dp" android:background="@drawable/ota_back_background" android:src="@drawable/ota_ic_back" android:contentDescription="В VoyahTune"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="24dp" android:orientation="vertical">
            <TextView android:id="@+id/ota_nav0" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="①  Новый релиз" android:textSize="23sp"/>
            <TextView android:id="@+id/ota_nav1" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="②  Скачивание" android:textSize="23sp"/>
            <TextView android:id="@+id/ota_nav2" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="③  Установка" android:textSize="23sp"/>
            <TextView android:id="@+id/ota_nav3" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="④  Готово" android:textSize="23sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ota_line"/>
        <TextView android:id="@+id/ota_service" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Подключение…" android:textSize="15sp"/>
        <TextView android:id="@+id/ota_installed" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Установлено: —" android:textSize="15sp"/>
    </LinearLayout>
    <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#303947"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:clipToPadding="false" android:scrollbars="none" android:descendantFocusability="beforeDescendants" android:focusableInTouchMode="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="28dp" android:paddingTop="132dp" android:paddingBottom="28dp" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1.62" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="168dp" android:padding="25dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/ota_update_intro">
                            <ImageView android:id="@+id/ota_hero_icon" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginEnd="24dp" android:padding="17dp" android:background="@drawable/ota_icon_background" android:src="@drawable/ota_ic_download" android:importantForAccessibility="no"/>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:id="@+id/ota_eyebrow" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ota_teal" android:textSize="13sp" android:letterSpacing="0.1"/>
                                <TextView android:id="@+id/ota_title" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="32sp" android:fontFamily="@font/ota_updater_arimo_bold" android:accessibilityLiveRegion="polite"/>
                                <TextView android:id="@+id/ota_subtitle" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="18sp" android:lineSpacingMultiplier="1.45"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/ota_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="25dp" android:orientation="vertical" android:background="@drawable/ota_card">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView android:id="@+id/ota_release" style="@style/ota_BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="26sp"/>
                                <TextView android:id="@+id/ota_badge" style="@style/ota_BodyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:background="@drawable/ota_badge" android:textColor="@color/ota_teal" android:textSize="14sp"/>
                            </LinearLayout>
                            <TextView android:id="@+id/ota_meta" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="17sp"/>
                            <TextView android:id="@+id/ota_detail" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:lineSpacingMultiplier="1.5" android:textIsSelectable="true"/>
                            <LinearLayout android:id="@+id/ota_meter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                    <TextView android:id="@+id/ota_progress_label" style="@style/ota_BodyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="20sp"/>
                                    <TextView android:id="@+id/ota_percent" style="@style/ota_BodyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/ota_teal" android:textSize="32sp"/>
                                </LinearLayout>
                                <ProgressBar android:id="@+id/ota_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:progressDrawable="@drawable/ota_update_progress" android:progressTint="@color/ota_teal" android:indeterminateTint="@color/ota_teal" android:progressBackgroundTint="@color/ota_line" android:max="100"/>
                                <TextView android:id="@+id/ota_progress_note" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:lineSpacingMultiplier="1.4"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:padding="25dp" android:orientation="vertical" android:background="@drawable/ota_card">
                        <ImageView android:id="@+id/ota_aside_icon" android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:background="@drawable/ota_icon_background" android:src="@drawable/ota_ic_shield" android:importantForAccessibility="no"/>
                        <TextView style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="ПРИ ОБНОВЛЕНИИ" android:textSize="13sp" android:letterSpacing="0.1"/>
                        <TextView android:id="@+id/ota_aside_title" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="24sp"/>
                        <TextView android:id="@+id/ota_aside_text" style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="18sp" android:lineSpacingMultiplier="1.55"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <LinearLayout android:id="@+id/ota_header" android:layout_width="match_parent" android:layout_height="113dp" android:paddingHorizontal="28dp" android:paddingTop="24dp" android:paddingBottom="24dp" android:orientation="horizontal" android:elevation="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/ota_MutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="СИСТЕМА" android:textColor="@color/ota_eyebrow" android:textSize="12sp" android:letterSpacing="0.208" android:fontFamily="@font/ota_updater_arimo_bold"/>
                    <TextView android:id="@+id/ota_header_title" style="@style/ota_BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Обновления VoyahTune" android:textSize="36sp" android:fontFamily="@font/ota_updater_arimo_bold"/>
                </LinearLayout>
                <ImageButton android:id="@+id/ota_settings" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="16dp" android:padding="18dp" android:background="@drawable/ota_button_secondary" android:src="@drawable/ota_ic_settings" android:contentDescription="Настройки обновлений"/>
            </LinearLayout>
        </FrameLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#303947"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="100dp" android:paddingHorizontal="28dp" android:paddingVertical="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/ota_footer_note" style="@style/ota_MutedText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:textSize="16sp" android:lineSpacingMultiplier="1.45"/>
            <Button android:id="@+id/ota_secondary" style="@style/ota_ActionButton" android:layout_width="wrap_content" android:layout_height="64dp" android:text="Проверить снова"/>
            <Button android:id="@+id/ota_primary" style="@style/ota_PrimaryButton" android:layout_width="wrap_content" android:minWidth="280dp" android:layout_height="64dp" android:layout_marginStart="16dp" android:text="Проверить обновления"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
