<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="ru.big.town.anative.permission.BIND_SET_MODES_SERVICE" />
    <!-- Список установленных приложений для «Выдать права на установку» -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <provider android:authorities="ru.big.town.anative.trips" />
        <package android:name="ru.big.town.restoremode" />
        <!-- Нужно для bindService к SetModesService (видимость пакетов, API 30+) -->
        <package android:name="ru.big.town.anative" />
        <package android:name="ru.big.town.updater" />
    </queries>

    <application
        android:name=".VoyahApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_restoremode"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_restoremode"
        android:supportsRtl="true"
        android:theme="@style/Theme.RestoreMode"
        tools:targetApi="31">
        <service android:name=".TripLocationService"
            android:exported="true"
            android:permission="ru.big.town.anative.permission.BIND_SET_MODES_SERVICE"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />
        <service android:name=".VoiceWarmupService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep user-enabled offline voice models ready for explicit button invocation; no background microphone capture." />
        </service>
        <activity android:name=".VoiceSettingsActivity" android:exported="false" />
        <activity android:name=".VoiceActivity"
            android:exported="true"
            android:permission="ru.big.town.anative.permission.BIND_SET_MODES_SERVICE"
            android:launchMode="singleTask"
            android:taskAffinity="ru.big.town.restoremode.voice"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.VoiceOverlay" />
        <activity
            android:name=".AdvanceActivityStarButton"
            android:exported="false" />
        <activity
            android:name=".AdvanceActivity"
            android:theme="@style/Theme.RestoreMode.Settings"
            android:exported="false" />
        <activity
            android:name=".TripHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".LoggingActivity"
            android:exported="false" />

        <!-- Диспетчер задач. exported без permission: его открывает и хук родного лаунчера (долгий тап
             по нижней кнопке дока), а у процесса лаунчера нет нашей signature-пермиссии. -->
        <activity
            android:name=".TaskManagerActivity"
            android:theme="@style/Theme.RestoreMode.Settings"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Native возвращает сюда результат drag. Signature-permission не позволяет сторонним
             приложениям подменять пропорции пресетов. -->
        <receiver
            android:name=".SplitRatioSaveReceiver"
            android:exported="true"
            android:permission="ru.big.town.anative.permission.BIND_SET_MODES_SERVICE">
            <intent-filter>
                <action android:name="ru.big.town.restoremode.SPLIT_RATIO_SAVE" />
            </intent-filter>
        </receiver>

        <!-- Explicit-only startup/wake request from Native. The signature permission prevents
             other applications from forcing preference reads or configuration broadcasts. -->
        <receiver
            android:name=".SavedConfigSyncReceiver"
            android:exported="true"
            android:permission="ru.big.town.anative.permission.BIND_SET_MODES_SERVICE" />

        <!-- Preloads the offline voice models after a reboot / app update so the first
             assistant invocation is not cold. BOOT_COMPLETED and QUICK_BOOT_COMPLETED are
             protected system broadcasts; the receiver is exported but only the system can
             deliver them. -->
        <receiver
            android:name=".VoiceBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICK_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".OtaActivity"
            android:process=":ota"
            android:taskAffinity="ru.big.town.restoremode.ota"
            android:theme="@style/ota_UpdaterTheme"
            android:exported="true"
            android:launchMode="singleTop" />

        <provider
            android:name=".RestoreModeContentProvider"
            android:authorities="ru.big.town.restoremode.restoremodecontentprovider"
            android:enabled="true"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
