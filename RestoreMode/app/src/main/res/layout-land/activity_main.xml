<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- ЛЕВАЯ КОЛОНКА: автосвет + режимы вождения + рекуперация + энергия -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:overScrollMode="always"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <!-- Автоматический ближний свет -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/layout_category_bg"
            android:orientation="vertical">

            <!-- Верхний ряд: заголовок + подзаголовок | показание датчика -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Автоматический ближний свет"
                        android:textColor="#ffffff"
                        android:textSize="26px" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="На автомобилях ОД С+ отключает матричный свет"
                        android:textColor="#888888"
                        android:textSize="20px" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textSensorLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Датчик: —"
                    android:textColor="#aaaaaa"
                    android:textSize="22px"
                    android:visibility="visible" />

            </LinearLayout>

            <!-- Нижний ряд: тоггл Выкл/Вкл + пороги датчика -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <!-- Сегмент-контрол Выкл/Вкл, небольшой -->
                <RadioGroup
                    android:id="@+id/autoLightGroup"
                    style="@style/radio_group_height_70_style"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:background="@drawable/radio_group_height_70_bg"
                    android:orientation="horizontal"
                    android:layout_marginEnd="20dp">

                    <RadioButton
                        android:id="@+id/autoLightOff"
                        style="@style/radio_button_height_70_style"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/radio_group_button_70_bg"
                        android:tag="OFF"
                        android:text="Выкл"
                        android:textColor="@color/radio_button_text_color_selector" />

                    <RadioButton
                        android:id="@+id/autoLightOn"
                        style="@style/radio_button_height_70_style"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/radio_group_button_70_bg"
                        android:tag="ON"
                        android:text="Вкл"
                        android:textColor="@color/radio_button_text_color_selector" />

                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вкл ≤"
                    android:textColor="#aaaaaa"
                    android:textSize="22px"
                    android:layout_marginEnd="4dp" />

                <NumberPicker
                    android:id="@+id/pickerSensorThreshold"
                    android:layout_width="100dp"
                    android:layout_height="100dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выкл >"
                    android:textColor="#aaaaaa"
                    android:textSize="22px"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="4dp" />

                <NumberPicker
                    android:id="@+id/pickerThresholdOff"
                    android:layout_width="100dp"
                    android:layout_height="100dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Режимы вождения -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/layout_category_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/drive_modes_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="binding_2"
                    android:text="Сохранять режим вождения"
                    android:textColor="#ffffff"
                    android:textSize="26px" />

                <Switch
                    android:id="@+id/switchDriveMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />

            </LinearLayout>

            <RadioGroup
                android:id="@+id/drive_modes_group"
                style="@style/radio_group_height_70_style"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/radio_group_height_70_bg"
                android:orientation="horizontal"
                android:layout_marginHorizontal="6dp">

                <RadioButton
                    android:id="@+id/ECO"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="ECO"
                    android:text="Eco"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/COMFORT"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="COMFORT"
                    android:text="Comf"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/SPORT"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="SPORT"
                    android:text="Sport"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/OUTING"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:animateLayoutChanges="true"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="OUTING"
                    android:text="Outing"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/SNOW"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="SNOW"
                    android:text="Snow"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/INDIVIDUAL"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="INDIVIDUAL"
                    android:text="Indiv"
                    android:textColor="@color/radio_button_text_color_selector" />

            </RadioGroup>
        </LinearLayout>

        <!-- Режим использования энергии -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/layout_category_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="6dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/energy_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="binding_2"
                    android:text="Сохранять режим энергии"
                    android:textColor="#ffffff"
                    android:textSize="26px" />

                <CheckBox
                    android:id="@+id/checkBox34"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:onClick="onCheckBox34Click"
                    android:text="3 кнопки"
                    android:textColor="#ffffffff"
                    android:textSize="26px" />

                <Switch
                    android:id="@+id/switchEnergy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />

            </LinearLayout>

            <RadioGroup
                android:id="@+id/energy_modes_group"
                style="@style/radio_group_height_70_style"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/radio_group_height_70_bg"
                android:orientation="horizontal"
                android:layout_marginHorizontal="6dp">

                <RadioButton
                    android:id="@+id/SMART"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="SMART"
                    android:text="Intelligent"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/EV"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="EV"
                    android:text="Electric"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/REV"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="REV"
                    android:text="Fuel mode"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/SREV"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="SREV"
                    android:text="Save mode"
                    android:textColor="@color/radio_button_text_color_selector" />

            </RadioGroup>
        </LinearLayout>

        <!-- Рекуперация -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/layout_category_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/recycle_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="binding_2"
                    android:text="Сохранять уровень рекуперации"
                    android:textColor="#ffffff"
                    android:textSize="26px" />

                <Switch
                    android:id="@+id/switchRecycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track" />

            </LinearLayout>

            <RadioGroup
                android:id="@+id/recycle_modes_group"
                style="@style/radio_group_height_70_style"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/radio_group_height_70_bg"
                android:orientation="horizontal"
                android:layout_marginHorizontal="6dp">

                <RadioButton
                    android:id="@+id/LOW"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="LOW"
                    android:text="Низкий"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/MEDIUM"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="MEDIUM"
                    android:text="Стандартный"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/HIGH"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="HIGH"
                    android:text="Высокий"
                    android:textColor="@color/radio_button_text_color_selector" />

            </RadioGroup>
        </LinearLayout>

        <!-- Отключить звук для пешеходов -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/layout_category_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/pedestrian_sound_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Предупреждение пешеходов"
                    android:textColor="#ffffff"
                    android:textSize="26px" />

            </LinearLayout>

            <!-- Сегмент-контрол Со звуком/Без звука под заголовком (как автосвет, шире под текст) -->
            <RadioGroup
                android:id="@+id/pedestrianSoundGroup"
                style="@style/radio_group_height_70_style"
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:layout_gravity="start"
                android:background="@drawable/radio_group_height_70_bg"
                android:orientation="horizontal"
                android:layout_marginHorizontal="6dp">

                <RadioButton
                    android:id="@+id/pedestrianSoundOff"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="260dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="OFF"
                    android:text="Со звуком"
                    android:textColor="@color/radio_button_text_color_selector" />

                <RadioButton
                    android:id="@+id/pedestrianSoundOn"
                    style="@style/radio_button_height_70_style"
                    android:layout_width="260dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:tag="ON"
                    android:text="Без звука"
                    android:textColor="@color/radio_button_text_color_selector" />

            </RadioGroup>

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!-- ПРАВАЯ КОЛОНКА: кнопки вертикально, фиксированная ширина -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingStart="4dp"
        android:paddingEnd="5dp"
        android:paddingTop="5dp">

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonClickApply"
            android:text="Применить"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

        <ProgressBar
            android:id="@+id/applyProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonAdvance"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:gravity="center"
            android:onClick="onButtonClickAdvance"
            android:text="Дополнительно"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/buttonAdvanceOff"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:gravity="center"
            android:onClick="onButtonClickAdvanceStarButton"
            android:text="На кнопку"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>
