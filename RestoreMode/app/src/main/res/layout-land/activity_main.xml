<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- ЛЕВАЯ ОБЛАСТЬ: все настройки перенесены в «Дополнительно» -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VoyahTune"
            android:textColor="#40FFFFFF"
            android:textSize="64px"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Настройки — в разделе «Дополнительно»"
            android:textColor="#40FFFFFF"
            android:textSize="24px" />

    </LinearLayout>

    <!-- ПРАВАЯ КОЛОНКА: кнопки вертикально, фиксированная ширина -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingStart="4dp"
        android:paddingEnd="5dp"
        android:paddingTop="5dp">

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonClickApply"
            android:text="Применить"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

        <ProgressBar
            android:id="@+id/applyProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonAdvance"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:gravity="center"
            android:onClick="onButtonClickAdvance"
            android:text="Дополнительно"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/buttonAdvanceOff"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:gravity="center"
            android:onClick="onButtonClickAdvanceStarButton"
            android:text="На кнопку"
            android:textColor="#FFFFFF"
            android:textSize="26dp"
            android:singleLine="true"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>
