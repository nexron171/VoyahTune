<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран = свой лончер: слева CarPlay-style док, справа контент (виджеты + плитки). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- ЛЕВЫЙ ДОК: продублированные ярлыки сплитов/приложений + кнопка «на главный» снизу -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:background="#111318"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/dockScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <!-- fillViewport + gravity=center → иконки по центру дока и по вертикали, и по горизонтали
                 (равный отступ сверху/снизу); при переполнении — обычная прокрутка. -->
            <LinearLayout
                android:id="@+id/dockIcons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />

        </ScrollView>

        <!-- Домик: выход на системный главный экран (мы уже на нашем «лончере») -->
        <FrameLayout
            android:id="@+id/dockHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dock_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onDockHome"
            android:paddingVertical="16dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dock_house" />

        </FrameLayout>

    </LinearLayout>

    <!-- ПРАВЫЙ КОНТЕНТ: то, что раньше было главным экраном (виджеты + плитки) -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- Верхний блок фиксированных виджетов: 5 колонок × 2 ряда (на весах внутри фикс. высоты) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:columnCount="5"
        android:rowCount="2"
        android:padding="10dp">

        <!-- Якоря колонок: 5 равных долей ширины -->
        <Space android:layout_row="0" android:layout_column="0" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" />
        <Space android:layout_row="0" android:layout_column="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" />
        <Space android:layout_row="0" android:layout_column="2" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" />
        <Space android:layout_row="0" android:layout_column="3" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" />
        <Space android:layout_row="0" android:layout_column="4" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" />
        <!-- Якоря рядов: 2 равные доли высоты -->
        <Space android:layout_row="0" android:layout_column="0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" />
        <Space android:layout_row="1" android:layout_column="0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" />

        <!-- Таймер поездки (2x2) с кнопками «История поездок» + «Сброс» -->
        <LinearLayout
            android:id="@+id/tripCard"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:layout_rowSpan="2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/layout_category_bg"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Время в пути"
                android:textColor="#aaaaaa"
                android:textSize="24px" />

            <TextView
                android:id="@+id/tripTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00:00"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="52px" />

            <TextView
                android:id="@+id/tripStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="нет активной поездки"
                android:textColor="#888888"
                android:textSize="20px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonTripHistory"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#373f4a"
                    android:onClick="onButtonTripHistory"
                    android:text="История поездок"
                    android:textColor="#FFFFFF"
                    android:textSize="22dp"
                    android:singleLine="true"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/buttonTripReset"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:backgroundTint="#373f4a"
                    android:onClick="onButtonTripReset"
                    android:text="Сброс"
                    android:textColor="#FFFFFF"
                    android:textSize="22dp"
                    android:singleLine="true"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Power Hold -->
        <LinearLayout
            android:id="@+id/cardLeaveCar"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark_ripple"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onButtonLeaveCar"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Power Hold"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="26px" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Не глушить машину при запирании"
                android:textColor="#aaaaaa"
                android:textSize="15px" />

        </LinearLayout>

        <!-- Режим мойки -->
        <LinearLayout
            android:id="@+id/cardWashMode"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark_ripple"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onCardWashMode"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Режим мойки"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="26px" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Машина засыпает и не реагирует на открытие дверей"
                android:textColor="#aaaaaa"
                android:textSize="15px" />

        </LinearLayout>

        <!-- Настройки -->
        <LinearLayout
            android:id="@+id/cardSettings"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark_ripple"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onButtonClickAdvance"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Настройки"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28px" />

        </LinearLayout>

        <!-- Настройки Android -->
        <LinearLayout
            android:id="@+id/cardAndroidSettings"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark_ripple"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onCardAndroidSettings"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Настройки Android"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28px" />

        </LinearLayout>

        <!-- Автосвет -->
        <LinearLayout
            android:id="@+id/cardAutoLight"
            android:layout_row="0"
            android:layout_column="4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark_ripple"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onCardAutoLight"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Автосвет"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28px" />

            <TextView
                android:id="@+id/autoLightBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/pill_inactive"
                android:text="не активно"
                android:textColor="#FFFFFF"
                android:textSize="18px" />

        </LinearLayout>

        <!-- Звук пешеходов -->
        <LinearLayout
            android:id="@+id/cardPedestrian"
            android:layout_row="1"
            android:layout_column="4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark_ripple"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onCardPedestrian"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Звук пешеходов"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28px" />

            <TextView
                android:id="@+id/pedestrianBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/pill_inactive"
                android:text="не активно"
                android:textColor="#FFFFFF"
                android:textSize="18px" />

        </LinearLayout>

    </GridLayout>

    <!-- Виджет «Прогрев батареи»: статус ВВБ + активация в один клик -->
    <LinearLayout
        android:id="@+id/cardBatteryHeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/layout_category_bg"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <!-- Графический индикатor: иконка батареи, тонируется цветом состояния -->
        <ImageView
            android:id="@+id/batteryHeatIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_battery_indicator"
            android:contentDescription="Состояние прогрева батареи" />

        <!-- Левая часть: температура + строки статуса -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Прогрев батареи"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="28px" />

                <!-- Цветная «пилюля» со статусом (цвет и текст задаются в коде) -->
                <TextView
                    android:id="@+id/batteryHeatState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="3dp"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20px" />

                <TextView
                    android:id="@+id/batteryHeatTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="за бортом: —"
                    android:textColor="#aaaaaa"
                    android:textSize="24px" />

            </LinearLayout>

            <TextView
                android:id="@+id/batteryHeatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Нагрев: —   ·   Pre-heat: —   ·   Автоподогрев: —"
                android:textColor="#cccccc"
                android:textSize="20px" />

            <TextView
                android:id="@+id/batteryHeatFail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#ff6b6b"
                android:textSize="20px"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Правая часть: активация в один клик -->
        <Button
            android:id="@+id/buttonBatteryHeat"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:minWidth="220dp"
            android:backgroundTint="#2f7fd0"
            android:onClick="onButtonBatteryHeat"
            android:text="Прогреть батарею"
            android:textColor="#FFFFFF"
            android:textSize="24dp"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <!-- Сплиты: прокручиваемая сетка плиток (по пресетам из «Разделение экрана») -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/splitTilesGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp" />

    </ScrollView>

    </LinearLayout>
    <!-- /mainContent -->

</LinearLayout>
