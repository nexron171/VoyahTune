<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран = свой лончер: слева CarPlay-style док, справа контент (виджеты + плитки). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- Контент главного экрана (свой док удалён — используется родной док головы; левый отступ под него
         задаётся в коде по window insets) -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ВЕСЬ контент главного экрана в горизонтальном скролле -->
        <HorizontalScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <!-- Сплиты и все тайлы: единая горизонтальная сетка -->
            <GridLayout
                android:id="@+id/splitTilesGrid"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:rowCount="5"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp" />

        </HorizontalScrollView>

    </LinearLayout>
    <!-- /mainContent -->

</LinearLayout>
