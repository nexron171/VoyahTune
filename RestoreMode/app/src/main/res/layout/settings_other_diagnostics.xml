<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp"
    android:layout_marginTop="16dp">
    <ru.big.town.restoremode.settings.ui.layout.SettingsRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="18dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Режим отладки"
                android:textSize="22sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Показывать дополнительную диагностическую информацию."
                android:textSize="17sp"
                android:textColor="#9aaac0"
                android:includeFontPadding="false"
                android:layout_marginTop="7dp"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchDebugMode"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </ru.big.town.restoremode.settings.ui.layout.SettingsRow>
    <LinearLayout
        android:id="@+id/debugInformationBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/settings_card"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отладочная информация"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_body_size" />
        <LinearLayout
            android:id="@+id/debugLightSensorRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
