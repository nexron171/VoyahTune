<?xml version="1.0" encoding="utf-8"?>
<ru.big.town.restoremode.SettingsGrid
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:settingsColumns="3"
    app:settingsEndColumnWeight="1.4">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/settings_visual">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оперативная память"
            android:textSize="16sp"
            android:textColor="#8fa6c4"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/textRamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Используется: —\nДоступно: —"
            android:textColor="@color/settings_muted"
            android:textSize="30sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/settings_visual">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Загрузка CPU"
            android:textSize="16sp"
            android:textColor="#8fa6c4"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/textCpuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="—"
            android:textColor="@color/settings_muted"
            android:textSize="30sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/settings_visual">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Системные хуки"
            android:textSize="16sp"
            android:textColor="#8fa6c4"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/textHookStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="Состояние ещё не опубликовано"
            android:textColor="@color/settings_muted"
            android:textSize="23sp" />
    </LinearLayout>
</ru.big.town.restoremode.SettingsGrid>
