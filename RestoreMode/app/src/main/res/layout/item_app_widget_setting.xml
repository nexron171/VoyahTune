<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:background="@drawable/layout_category_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/appWidgetSettingIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/appWidgetSettingLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="24px" />

        <ImageButton
            android:id="@+id/appWidgetSettingDelete"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="@drawable/nav_back_circle_bg"
            android:src="@drawable/ic_delete"
            android:contentDescription="Убрать виджет" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ширина"
            android:textColor="#E0E0E0"
            android:textSize="24px" />

        <Spinner
            android:id="@+id/appWidgetSettingWidth"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Высота"
            android:textColor="#E0E0E0"
            android:textSize="24px" />

        <Spinner
            android:id="@+id/appWidgetSettingHeight"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <Switch
        android:id="@+id/appWidgetSettingAutoStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Автозапуск приложения при открытии"
        android:textColor="#FFFFFF"
        android:textSize="20px"
        android:thumb="@drawable/switch_thumb"
        android:track="@drawable/switch_track" />

    <LinearLayout
        android:id="@+id/appWidgetDelayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Задержка автозапуска"
            android:textColor="#E0E0E0"
            android:textSize="24px" />

        <SeekBar
            android:id="@+id/appWidgetSettingDelay"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:max="59" />

        <TextView
            android:id="@+id/appWidgetSettingDelayText"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="3 сек"
            android:textColor="#FFFFFF"
            android:textSize="20px" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/appWidgetProfiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/appWidgetAddProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить приложение" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="При нажатии на виджет появится выбор приложения"
        android:textColor="#AAAAAA"
        android:textSize="16px" />

</LinearLayout>
