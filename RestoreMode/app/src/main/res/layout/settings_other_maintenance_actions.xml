<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/buttonCloseAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onButtonCloseAll"
            android:text="Закрыть приложения"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_body_size"
            app:cornerRadius="20dp"
            android:tag="settings.action"
            android:minHeight="48dp" />
        <Button
            android:id="@+id/buttonGrantInstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onButtonGrantInstall"
            android:text="Выдать права на установку"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_body_size"
            app:cornerRadius="20dp"
            android:tag="settings.action"
            android:minHeight="48dp" />
        <Button
            android:id="@+id/buttonReboot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onButtonRebootSystem"
            android:text="Перезагрузить систему"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_body_size"
            app:cornerRadius="20dp"
            android:tag="settings.action"
            android:minHeight="48dp" />
        <Button
            android:id="@+id/buttonLogging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onButtonLogging"
            android:text="Логирование"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_body_size"
            app:cornerRadius="20dp"
            android:tag="settings.action"
            android:minHeight="48dp" />
    </LinearLayout>
</LinearLayout>
