<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Сплит"
            android:textSize="24sp"
            android:textColor="#f3f5fa"
            android:includeFontPadding="false"
            android:id="@+id/settingsSplitTitle"
            android:layout_weight="1" />
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1:1"
            android:textSize="16sp"
            android:textColor="#b2d3fb"
            android:includeFontPadding="false"
            android:id="@+id/settingsSplitRatioLabel"
            android:padding="8dp"
            android:background="@drawable/settings_pill"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="16dp" />
        <Button android:id="@+id/splitDeleteBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="×"
            android:textColor="@color/settings_text"
            android:textSize="18sp"
            app:cornerRadius="18dp"
            android:tag="settings.delete"
            android:minHeight="48dp"
            android:contentDescription="Удалить сплит" />
    </LinearLayout>
    <ru.big.town.restoremode.settings.ui.preview.SettingsPreviewView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="18dp"
        app:settingsPreviewKind="split"
        android:id="@+id/settingsSplitPreview" />
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginEnd="14dp">
            <TextView android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Слева"
                android:textSize="15sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginBottom="8dp" />
            <Button android:id="@+id/splitLeftBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Слева: не выбрано"
                android:textColor="@color/settings_text"
                android:textSize="18sp"
                android:singleLine="true"
                app:cornerRadius="18dp"
                android:tag="settings.field"
                android:minHeight="48dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Справа"
                android:textSize="15sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginBottom="8dp" />
            <Button android:id="@+id/splitRightBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Справа: не выбрано"
                android:textColor="@color/settings_text"
                android:textSize="18sp"
                android:singleLine="true"
                app:cornerRadius="18dp"
                android:tag="settings.field"
                android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Соотношение сторон"
        android:textSize="16sp"
        android:textColor="#95a8c3"
        android:includeFontPadding="false"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp" />
    <ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/settingsSplitRatios" />
    <Spinner android:id="@+id/splitRatioSpinner"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:popupBackground="#2b2f38"
        android:visibility="gone" />
    <Switch android:id="@+id/splitResizableSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Изменяемая пропорция (тянуть делитель)"
        android:textColor="@color/settings_text"
        android:textSize="18sp"
        android:visibility="gone" />
</LinearLayout>
