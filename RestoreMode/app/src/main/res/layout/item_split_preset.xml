<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical"
    android:background="@drawable/layout_category_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/splitLeftBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#373f4a"
            android:text="Слева: не выбрано"
            android:textColor="#FFFFFF"
            android:textSize="22dp"
            android:singleLine="true"
            app:cornerRadius="18dp" />

        <Button
            android:id="@+id/splitRightBtn"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:backgroundTint="#373f4a"
            android:text="Справа: не выбрано"
            android:textColor="#FFFFFF"
            android:textSize="22dp"
            android:singleLine="true"
            app:cornerRadius="18dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Соотношение"
            android:textColor="#aaaaaa"
            android:textSize="22px" />

        <Spinner
            android:id="@+id/splitRatioSpinner"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:popupBackground="#2b2f38" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/splitDeleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="#5a2a2a"
            android:text="Удалить"
            android:textColor="#FFFFFF"
            android:textSize="22dp"
            app:cornerRadius="18dp" />

    </LinearLayout>

</LinearLayout>
