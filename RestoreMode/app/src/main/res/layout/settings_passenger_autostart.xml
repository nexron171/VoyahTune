<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp"
    android:layout_marginBottom="16dp">
    <include layout="@layout/settings_passenger_autostart_toggle" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Запуск выполняет Native; водительская задача и её сетка не перезапускаются."
        android:textSize="15sp"
        android:textColor="#788ba5"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.4" />
</LinearLayout>
