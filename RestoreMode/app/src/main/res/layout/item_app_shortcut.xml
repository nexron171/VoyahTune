<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/settings_sequence"
    android:paddingHorizontal="17dp"
    android:paddingVertical="13dp">
    <ImageView android:id="@+id/shortcutIco"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:background="@drawable/settings_icon" />
    <TextView android:id="@+id/shortcutLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/settings_text"
        android:textSize="22sp"
        android:maxWidth="500dp" />
    <ImageButton android:id="@+id/shortcutDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:padding="4dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/settings_icon_trash"
        android:contentDescription="Убрать приложение" />
</LinearLayout>
