<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <Switch
        android:id="@+id/carPlayEnabled"
        style="@style/SettingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:saveEnabled="false"
        android:text="@string/carplay_enabled"
        android:textColor="@color/settings_text"
        android:textSize="22sp" />
    <LinearLayout
        android:id="@+id/carPlayEnabledContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/carPlayFullscreenCard"
            style="@style/SettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Switch
                android:id="@+id/carPlayFullscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/carplay_fullscreen"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_fullscreen_description"
                android:textColor="@color/settings_muted"
                android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carplay_layout_title"
                android:textColor="@color/settings_text"
                android:textSize="24sp" />
            <RadioGroup
                android:id="@+id/carPlayLayoutChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:saveEnabled="false">
                <RadioButton
                    android:id="@+id/carPlayLayoutClassic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minHeight="132dp"
                    android:button="@null"
                    android:drawableTop="@drawable/carplay_layout_driver"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:saveEnabled="false"
                    android:text="@string/carplay_layout_classic"
                    android:textSize="18sp" />
                <RadioButton
                    android:id="@+id/carPlayLayoutBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minHeight="132dp"
                    android:button="@null"
                    android:drawableTop="@drawable/carplay_layout_bottom"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:saveEnabled="false"
                    android:text="@string/carplay_layout_bottom"
                    android:textSize="18sp" />
                <RadioButton
                    android:id="@+id/carPlayLayoutAston"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:minHeight="132dp"
                    android:button="@null"
                    android:drawableTop="@drawable/carplay_layout_dual"
                    android:drawablePadding="12dp"
                    android:gravity="center"
                    android:saveEnabled="false"
                    android:text="@string/carplay_layout_aston"
                    android:textSize="18sp" />
            </RadioGroup>
            <TextView
                android:id="@+id/carPlayUiScaleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/carplay_ui_scale_title"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <SeekBar
                android:id="@+id/carPlayUiScale"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/carplay_ui_scale_title"
                android:max="3"
                android:progress="2"
                android:saveEnabled="false" />
            <LinearLayout
                android:id="@+id/carPlayUiScalePresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/carPlayUiScalePreset75"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_muted"
                    android:textSize="18sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/carPlayUiScalePreset85"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_muted"
                    android:textSize="18sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/carPlayUiScalePreset100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_muted"
                    android:textSize="18sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/carPlayUiScalePreset115"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_muted"
                    android:textSize="18sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/carPlayUiScaleFixedTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_ui_scale_fixed"
                android:textColor="@color/settings_muted"
                android:textSize="18sp"
                android:visibility="gone" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/carplay_layout_reconnect"
                android:textColor="@color/settings_muted"
                android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carplay_settings_connection"
                android:textColor="@color/settings_text"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/carPlayConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/carplay_settings_disconnected"
                android:textColor="@color/settings_accent"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/carPlayPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/settings_muted"
                android:textSize="18sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">
                <Button
                    android:id="@+id/carPlayOpenHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:tag="settings.action"
                    android:text="@string/carplay_settings_open_home" />
                <Button
                    android:id="@+id/carPlayDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:minHeight="48dp"
                    android:tag="settings.action"
                    android:visibility="gone"
                    android:text="@string/carplay_home_disconnect" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Switch
                android:id="@+id/carPlayThemeByLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/carplay_theme_by_light"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_theme_by_light_description"
                android:textColor="@color/settings_muted"
                android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carplay_volume_title"
                android:textColor="@color/settings_text"
                android:textSize="24sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_volume_description"
                android:textColor="@color/settings_muted"
                android:textSize="18sp" />
            <Switch
                android:id="@+id/carPlayDuckMusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/carplay_duck_music"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/carPlayMediaVolumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/carplay_volume_media"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <SeekBar
                android:id="@+id/carPlayMediaVolume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:enabled="false"
                android:saveEnabled="false"
                android:contentDescription="@string/carplay_volume_media" />
            <TextView
                android:id="@+id/carPlayNavigationVolumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_volume_navigation"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <SeekBar
                android:id="@+id/carPlayNavigationVolume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:enabled="false"
                android:saveEnabled="false"
                android:contentDescription="@string/carplay_volume_navigation" />
            <TextView
                android:id="@+id/carPlayPhoneVolumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_volume_phone"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <SeekBar
                android:id="@+id/carPlayPhoneVolume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:enabled="false"
                android:saveEnabled="false"
                android:contentDescription="@string/carplay_volume_phone" />
            <TextView
                android:id="@+id/carPlaySiriVolumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/carplay_volume_siri"
                android:textColor="@color/settings_text"
                android:textSize="22sp" />
            <SeekBar
                android:id="@+id/carPlaySiriVolume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:enabled="false"
                android:saveEnabled="false"
                android:contentDescription="@string/carplay_volume_siri" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
