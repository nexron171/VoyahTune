<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <ru.big.town.restoremode.settings.ui.layout.SettingsRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="18dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:padding="8dp"
            android:src="@drawable/settings_icon_lane_change"
            android:background="@drawable/settings_icon"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TLC — помощь при перестроении"
                android:textSize="22sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Функция автоматического перестроения при активном круиз-контроле при активации сигнала поворотника"
                android:textSize="17sp"
                android:textColor="#9aaac0"
                android:includeFontPadding="false"
                android:layout_marginTop="7dp"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchApolloTlc"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:enabled="true"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </ru.big.town.restoremode.settings.ui.layout.SettingsRow>
</LinearLayout>
