<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tripHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#22252f"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingVertical="20dp">

    <!-- Закреплённая панель: назад, заголовок, очистка истории. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/buttonBackHistory"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="20dp"
            android:background="@drawable/nav_back_circle_bg"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            android:onClick="onButtonBackHistory"
            android:contentDescription="Назад" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="История поездок"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="44px" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tripDeleteAll"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:paddingHorizontal="24dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Удалить все записи"
            android:textAllCaps="false"
            android:textColor="#EEF1F6"
            android:textSize="20sp"
            android:enabled="false"
            app:backgroundTint="#373F4A"
            app:cornerRadius="26dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tripLogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
