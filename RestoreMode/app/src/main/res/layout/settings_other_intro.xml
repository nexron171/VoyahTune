<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="27dp"
    android:paddingVertical="23dp"
    android:minHeight="122dp"
    android:background="@drawable/settings_intro">
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:padding="17dp"
        android:src="@drawable/settings_icon_cpu"
        android:background="@drawable/settings_intro_icon"
        android:importantForAccessibility="no"
        android:layout_marginEnd="24dp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Всё для комфортной работы системы"
            android:textSize="26sp"
            android:textColor="#f3f5fa"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Управляйте оформлением, доступом к геолокации и служебными настройками."
            android:textSize="18sp"
            android:maxWidth="900dp"
            android:textColor="#adbed5"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.45" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VoyahTune"
        android:textSize="16sp"
        android:textColor="#b2d3fb"
        android:includeFontPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/settings_pill"
        android:layout_marginStart="24dp" />
</LinearLayout>
