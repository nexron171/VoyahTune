<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <ru.big.town.restoremode.SettingsGrid
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:settingsColumns="2">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цвет автомобиля в карточке шин"
                android:textSize="22sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false" />
            <Spinner
                android:id="@+id/energyCarColor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="@color/settings_inset"
                android:visibility="gone" />
            <ru.big.town.restoremode.SettingsColorPalette
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Батарея, кВт·ч"
                        android:textSize="15sp"
                        android:textColor="#97a6bc"
                        android:includeFontPadding="false" />
                    <EditText
                        android:id="@+id/energyBatteryCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:textColor="@color/settings_text"
                        android:textSize="@dimen/settings_body_size"
                        android:padding="12dp"
                        android:background="@drawable/settings_field" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Бак, л"
                        android:textSize="15sp"
                        android:textColor="#97a6bc"
                        android:includeFontPadding="false" />
                    <EditText
                        android:id="@+id/energyTankCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:textColor="@color/settings_text"
                        android:textSize="@dimen/settings_body_size"
                        android:padding="12dp"
                        android:background="@drawable/settings_field" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="По умолчанию: 43 кВт·ч и 56 л. Значения общие для графика и текущей поездки."
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.55"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginTop="18dp" />
        </LinearLayout>
    </ru.big.town.restoremode.SettingsGrid>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Расчёты приблизительны и не должны использоваться для принятия решения о заправке или зарядке."
        android:textSize="16sp"
        android:textColor="#d9c69d"
        android:includeFontPadding="false"
        android:background="@drawable/settings_notice"
        android:paddingHorizontal="19dp"
        android:paddingVertical="15dp"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="20dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="История уровней сохраняется за последние 150 км с шагом 100 м. Оба средних расхода учитывают только снижения уровней; зарядка и заправка не вычитаются из расхода. Время поездки учитывается только в D."
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.55"
        android:textColor="#97a6bc"
        android:includeFontPadding="false"
        android:layout_marginTop="18dp" />
</LinearLayout>
