<?xml version="1.0" encoding="utf-8"?>
<ru.big.town.restoremode.settings.ui.layout.SettingsWidgetCard
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    app:settingsToggleRef="@id/switchShowFragrance"
    android:padding="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ароматизатор\nАромат, интенсивность и таймер"
            android:textSize="23sp"
            android:textColor="#f3f5fa" />
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchShowFragrance"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:contentDescription="Показать виджет ароматизатора"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </LinearLayout>
    <ru.big.town.restoremode.settings.ui.preview.WidgetSizeGrid
        android:id="@+id/fragranceSizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:settingsTileKey="fragranceWidget"
        app:settingsTileWidth="2"
        app:settingsTileHeight="2" />
</ru.big.town.restoremode.settings.ui.layout.SettingsWidgetCard>
