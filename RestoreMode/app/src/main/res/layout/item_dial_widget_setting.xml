<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:layout_marginBottom="12dp">
    <ImageView android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="12dp"
        android:src="@drawable/settings_icon_phone"
        android:background="@drawable/settings_icon"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp" />
    <LinearLayout android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">
        <EditText android:id="@+id/dialSettingName"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="Имя контакта"
            android:inputType="textCapSentences"
            android:textColor="@color/settings_text"
            android:textColorHint="#999999"
            android:textSize="18sp"
            android:layout_weight="1"
            android:background="@drawable/settings_field"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="12dp" />
        <EditText android:id="@+id/dialSettingNumber"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="Номер: 4–10 цифр"
            android:inputType="number"
            android:maxLength="10"
            android:textColor="@color/settings_text"
            android:textColorHint="#999999"
            android:textSize="18sp"
            android:layout_weight="1"
            android:background="@drawable/settings_field"
            android:paddingHorizontal="12dp" />
    </LinearLayout>
    <Button android:id="@+id/dialSettingSave"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="10dp"
        android:text="Сохранить"
        android:textColor="@color/settings_text"
        android:textSize="18sp"
        android:singleLine="true"
        android:tag="settings.action" />
    <ImageButton android:id="@+id/dialSettingDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/settings_icon_trash"
        android:contentDescription="Удалить карточку набора"
        android:padding="4dp" />
</LinearLayout>
