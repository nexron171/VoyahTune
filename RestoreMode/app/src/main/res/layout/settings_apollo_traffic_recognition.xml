<?xml version="1.0" encoding="utf-8"?>
<ru.big.town.restoremode.settings.ui.layout.SettingsGrid
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:settingsColumns="2">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_card"
        android:padding="25dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="9dp"
                android:src="@drawable/settings_icon_traffic_light"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Распознавание светофоров"
                android:textSize="24sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false"
                android:layout_weight="1" />
            <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
                android:id="@+id/switchApolloTrafficLights"
                android:layout_width="58dp"
                android:layout_height="32dp"
                android:enabled="true"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подсказки о сигналах светофоров."
            android:textSize="17sp"
            android:textColor="#97a6bc"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Звук при зелёном сигнале"
            android:textSize="16sp"
            android:textColor="#95a8c3"
            android:includeFontPadding="false"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp" />
        <LinearLayout
            android:id="@+id/apolloGreenSoundContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup
                android:id="@+id/apolloGreenSoundGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/apolloGreenSoundOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:text="Выключен"
                    android:textColor="@color/radio_button_text_color_selector"
                    android:layout_weight="0"
                    android:maxLines="3" />
                <RadioButton
                    android:id="@+id/apolloGreenSoundOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/radio_group_button_70_bg"
                    android:text="Включён"
                    android:textColor="@color/radio_button_text_color_selector"
                    android:layout_weight="0"
                    android:maxLines="3" />
            </ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_card"
        android:padding="25dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="9dp"
                android:src="@drawable/settings_icon_roadworks"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Распознавание дорожных знаков"
                android:textSize="24sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false"
                android:layout_weight="1" />
            <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
                android:id="@+id/switchApolloTrafficSigns"
                android:layout_width="58dp"
                android:layout_height="32dp"
                android:enabled="true"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Распознавание и отображение дорожных знаков."
            android:textSize="17sp"
            android:textColor="#97a6bc"
            android:includeFontPadding="false" />
    </LinearLayout>
</ru.big.town.restoremode.settings.ui.layout.SettingsGrid>
