<?xml version="1.0" encoding="utf-8"?>
<ru.big.town.restoremode.settings.ui.layout.SettingsGrid
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:settingsColumns="2">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_card"
        android:padding="25dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="9dp"
                android:src="@drawable/settings_icon_sound"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Предупреждение пешеходов"
                android:textSize="24sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:id="@+id/pedestrian_sound_text" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup
            android:id="@+id/pedestrianSoundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/pedestrianSoundOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/radio_group_button_70_bg"
                android:tag="OFF"
                android:text="Со звуком"
                android:textColor="@color/radio_button_text_color_selector"
                android:layout_weight="0"
                android:maxLines="3" />
            <RadioButton
                android:id="@+id/pedestrianSoundOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/radio_group_button_70_bg"
                android:tag="ON"
                android:text="Без звука"
                android:textColor="@color/radio_button_text_color_selector"
                android:layout_weight="0"
                android:maxLines="3" />
        </ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_card"
        android:padding="25dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="9dp"
                android:src="@drawable/settings_icon_light"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Автоматический ближний свет"
                android:textSize="24sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false"
                android:layout_weight="1" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup
            android:id="@+id/autoLightGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="20dp">
            <RadioButton
                android:id="@+id/autoLightOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/radio_group_button_70_bg"
                android:tag="OFF"
                android:text="Выкл"
                android:textColor="@color/radio_button_text_color_selector"
                android:layout_weight="0"
                android:maxLines="3" />
            <RadioButton
                android:id="@+id/autoLightOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/radio_group_button_70_bg"
                android:tag="ON"
                android:text="Вкл"
                android:textColor="@color/radio_button_text_color_selector"
                android:layout_weight="0"
                android:maxLines="3" />
        </ru.big.town.restoremode.settings.ui.controls.SettingsChoiceGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="На автомобилях ОД С+ отключает матричный свет."
            android:textSize="17sp"
            android:textColor="#97a6bc"
            android:includeFontPadding="false"
            android:layout_marginTop="16dp" />
        <TextView
            android:id="@+id/textSensorLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Датчик: —"
            android:textColor="@color/settings_muted"
            android:textSize="@dimen/settings_caption_size"
            android:visibility="visible" />
    </LinearLayout>
</ru.big.town.restoremode.settings.ui.layout.SettingsGrid>
