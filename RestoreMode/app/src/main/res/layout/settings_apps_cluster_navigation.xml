<?xml version="1.0" encoding="utf-8"?>
<ru.big.town.restoremode.settings.ui.layout.SettingsRow
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Манёвры на приборной панели"
            android:textSize="22sp"
            android:textColor="#f3f5fa"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Показывать повороты и расстояние из CarPlay, Яндекс Навигатора и 2ГИС."
            android:textSize="17sp"
            android:textColor="#9aaac0"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.45" />
    </LinearLayout>
    <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
        android:id="@+id/switchClusterNavigation"
        android:layout_width="58dp"
        android:layout_height="32dp"
        android:contentDescription="Манёвры на приборной панели"
        android:thumb="@drawable/switch_thumb"
        android:track="@drawable/switch_track" />
</ru.big.town.restoremode.settings.ui.layout.SettingsRow>
