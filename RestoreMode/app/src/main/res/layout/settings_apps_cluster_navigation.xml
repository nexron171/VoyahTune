<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Манёвры на приборной панели"
                android:textSize="22sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Показывать повороты и расстояние из CarPlay, Яндекс Навигатора и 2ГИС."
                android:textSize="17sp"
                android:textColor="#9aaac0"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchClusterNavigation"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:contentDescription="Манёвры на приборной панели"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Отображать название улицы"
                android:textSize="22sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Показывать название дороги рядом с манёвром. При отключении остаются стрелка и расстояние."
                android:textSize="17sp"
                android:textColor="#9aaac0"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchClusterNavigationShowStreet"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:contentDescription="Отображать название улицы"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Транслитерация на приборной панели"
                android:textSize="22sp"
                android:textColor="#f3f5fa"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Заменять русские буквы латинскими в названиях дорог и единицах расстояния (m, km). Адресные обозначения сокращаются автоматически."
                android:textSize="17sp"
                android:textColor="#9aaac0"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchClusterNavigationTransliteration"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:contentDescription="Транслитерация на приборной панели"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </LinearLayout>
</LinearLayout>
