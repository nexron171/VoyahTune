<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_dark_ripple"
    android:clickable="true"
    android:focusable="true">

    <HorizontalScrollView
        android:id="@+id/appWidgetLauncherScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/appWidgetList"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />

    </HorizontalScrollView>

    <TextView
        android:id="@+id/appWidgetBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/widget_badge_bg"
        android:minWidth="24dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/appWidgetLauncherControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/appWidgetSwapLauncher"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nav_back_circle_bg"
            android:src="@drawable/ic_swap"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:alpha="0.85"
            android:contentDescription="Обмен приложениями" />

        <ImageButton
            android:id="@+id/appWidgetDragHandleLauncher"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/nav_back_circle_bg"
            android:src="@drawable/ic_drag_handle"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:alpha="0.85"
            android:contentDescription="Перетащить" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/appWidgetOverlayControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/appWidgetControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/appWidgetDragHandle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/nav_back_circle_bg"
                android:src="@drawable/ic_drag_handle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:alpha="0.95"
                android:contentDescription="Перетащить" />

            <ImageButton
                android:id="@+id/appWidgetExpand"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/nav_back_circle_bg"
                android:src="@drawable/ic_expand"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:alpha="0.95"
                android:contentDescription="Развернуть" />

            <ImageButton
                android:id="@+id/appWidgetSwap"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/nav_back_circle_bg"
                android:src="@drawable/ic_swap"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:alpha="0.95"
                android:contentDescription="Обмен приложениями" />

            <ImageButton
                android:id="@+id/appWidgetClose"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/nav_back_circle_bg"
                android:src="@drawable/ic_close"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:alpha="0.95"
                android:contentDescription="Закрыть" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/appWidgetDpiControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appWidgetDpiPlus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.95"
                android:background="@drawable/nav_back_circle_bg"
                android:clickable="true"
                android:contentDescription="Увеличить DPI"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/appWidgetDpiMinus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:alpha="0.95"
                android:background="@drawable/nav_back_circle_bg"
                android:clickable="true"
                android:contentDescription="Уменьшить DPI"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
