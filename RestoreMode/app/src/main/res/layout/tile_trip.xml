<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tripCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_category_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tripDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:textAppearance="@style/EnergyLabelText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Время в пути"
        android:textAppearance="@style/EnergyLabelText" />

    <TextView
        android:id="@+id/tripTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="0:00:00"
        android:textAppearance="@style/EnergyValueText"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/tripStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="нет активной поездки"
        android:textAppearance="@style/EnergyLabelText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonTripHistory"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonTripHistory"
            android:singleLine="true"
            android:text="История поездок"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/energy_control_text_size"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/buttonTripStop"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonTripStop"
            android:singleLine="true"
            android:text="Стоп"
            android:enabled="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/energy_control_text_size"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
