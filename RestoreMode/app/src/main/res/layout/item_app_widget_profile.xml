<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="14dp">
    <ImageView android:id="@+id/appWidgetProfileIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:scaleType="fitCenter" />
    <TextView android:id="@+id/appWidgetProfileLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/settings_text"
        android:textSize="19sp" />
    <Spinner android:id="@+id/appWidgetProfileDpi"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:textColor="@color/settings_text"
        android:layout_marginStart="8dp" />
    <ImageButton android:id="@+id/appWidgetProfileDelete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Удалить приложение из виджета"
        android:src="@drawable/settings_icon_trash"
        android:background="@android:color/transparent"
        android:padding="6dp" />
</LinearLayout>
