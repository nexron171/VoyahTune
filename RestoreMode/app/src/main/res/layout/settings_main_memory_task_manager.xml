<?xml version="1.0" encoding="utf-8"?>
<ru.big.town.restoremode.settings.ui.layout.SettingsGrid
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:settingsColumns="2"
    android:layout_marginBottom="0dp">
    <ru.big.town.restoremode.settings.ui.layout.SettingsWidgetCard
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_card"
        app:settingsToggleRef="@id/switchShowClearMemory"
        android:padding="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp"
            android:minHeight="100dp">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp"
                android:src="@drawable/settings_icon_trash"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Очистить память"
                    android:textSize="23sp"
                    android:textColor="#f3f5fa"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Закрытие сторонних приложений · 1 × 1"
                    android:textSize="16sp"
                    android:textColor="#95a5bd"
                    android:includeFontPadding="false"
                    android:layout_marginTop="7dp"
                    android:lineSpacingMultiplier="1.45" />
            </LinearLayout>
            <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
                android:id="@+id/switchShowClearMemory"
                android:layout_width="58dp"
                android:layout_height="32dp"
                android:contentDescription="Очистить память"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track" />
        </LinearLayout>
    </ru.big.town.restoremode.settings.ui.layout.SettingsWidgetCard>
    <ru.big.town.restoremode.settings.ui.layout.SettingsWidgetCard
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_card"
        app:settingsToggleRef="@id/switchShowTaskManagerTile"
        android:padding="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp"
            android:minHeight="100dp">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp"
                android:src="@drawable/settings_icon_apps"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Диспетчер задач"
                    android:textSize="23sp"
                    android:textColor="#f3f5fa"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Открытые приложения и их закрепление"
                    android:textSize="16sp"
                    android:textColor="#95a5bd"
                    android:includeFontPadding="false"
                    android:layout_marginTop="7dp"
                    android:lineSpacingMultiplier="1.45" />
            </LinearLayout>
            <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
                android:id="@+id/switchShowTaskManagerTile"
                android:layout_width="58dp"
                android:layout_height="32dp"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track" />
        </LinearLayout>
    </ru.big.town.restoremode.settings.ui.layout.SettingsWidgetCard>
</ru.big.town.restoremode.settings.ui.layout.SettingsGrid>
