<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskCard" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/settings_card" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <TextView android:id="@+id/taskCardStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Открыто" android:textColor="@color/settings_muted" android:textSize="16sp" />
        <ImageButton android:id="@+id/taskCardPin" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/settings_field" android:contentDescription="Закрепить приложение" android:padding="8dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_pin" />
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <ImageView android:id="@+id/taskCardIcon" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:contentDescription="Переключиться на приложение" android:scaleType="fitCenter" />
    <TextView android:id="@+id/taskCardLabel" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"
        android:ellipsize="end" android:gravity="center" android:maxLines="2" android:textColor="@color/settings_text" android:textSize="23sp" />
    <TextView android:id="@+id/taskCardWidget" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginTop="4dp"
        android:background="@drawable/settings_pill" android:paddingHorizontal="12dp" android:gravity="center" android:text="В виджете"
        android:textColor="@color/settings_accent" android:textSize="15sp" android:visibility="invisible" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/taskCardClose" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="12dp" android:tag="settings.secondary" android:text="Закрыть" android:contentDescription="Закрыть приложение" />
</LinearLayout>
