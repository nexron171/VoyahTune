<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_category_bg_noround"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp"
    android:fitsSystemWindows="true"
    tools:context=".AdvanceActivity">

    <!-- Строка 1: Назад | Повторы + NumberPicker | Очистить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonClickFinish"
            android:text="Назад"
            android:textColor="#FFFFFF"
            android:textSize="40dp"
            app:cornerRadius="20dp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Повторы"
            android:textColor="#FFFFFF"
            android:textSize="40dp" />

        <NumberPicker
            android:id="@+id/pickerCustomCommandCount"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="#C14A24"
            android:outlineSpotShadowColor="#8BC34A" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonClean"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:backgroundTint="#373f4a"
            android:onClick="onButtonClickClean"
            android:text="Очистить"
            android:textColor="#FFFFFF"
            android:textSize="40dp"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <!-- Строка 2: предупреждение слева + EditText справа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/TextWarn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/activity_advance_text"
            android:textColor="#ff0000"
            android:textSize="20px"
            android:layout_marginEnd="12dp" />

        <EditText
            android:id="@+id/rawCanCodes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#ffffff"
            android:fontFamily="monospace"
            android:gravity="top"
            android:text="1f 08 00 04 ff f8 00 01 01 7f\n"
            android:textColor="#909090"
            android:textSize="26px"
            android:padding="8dp" />

    </LinearLayout>


</LinearLayout>
