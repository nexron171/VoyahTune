<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background"
    android:orientation="horizontal"
    tools:context=".AdvanceActivity">
    <ru.big.town.restoremode.settings.shell.SettingsNavigationRail
        android:id="@+id/settingsNavigationRail"
        android:layout_width="300dp"
        android:layout_height="match_parent" />
    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="20dp"
        android:background="#303947" />
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settingsSectionContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ru.big.town.restoremode.settings.shell.SettingsHeaderView
            android:id="@+id/settingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>
