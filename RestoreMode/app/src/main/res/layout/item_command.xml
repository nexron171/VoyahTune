<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">
    <Button android:id="@+id/cmdButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:textAllCaps="false"
        android:textColor="@color/settings_text"
        android:textSize="24px"
        android:singleLine="false"
        android:ellipsize="end"
        app:cornerRadius="14dp"
        android:tag="settings.example"
        android:minHeight="72dp" />
    <ImageButton android:id="@+id/cmdDelete"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginStart="10dp"
        android:padding="15dp"
        android:background="@drawable/nav_back_circle_bg"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        android:contentDescription="Удалить команду" />
</LinearLayout>
