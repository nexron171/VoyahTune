<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="24dp"
    android:background="@drawable/settings_header"
    android:paddingBottom="24dp"
    android:minHeight="112dp">
    <ImageButton
        android:id="@+id/settingsCategoryBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:padding="16dp"
        android:background="@drawable/settings_back"
        android:src="@drawable/settings_icon_back"
        android:scaleType="fitCenter"
        android:contentDescription="К категориям главного экрана"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ПЕРСОНАЛИЗАЦИЯ"
            android:textSize="12sp"
            android:textColor="#8298b6"
            android:includeFontPadding="false"
            android:id="@+id/settingsEyebrow"
            android:letterSpacing="0.208"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Режимы вождения и безопасность"
            android:textColor="@color/settings_text"
            android:textStyle="normal"
            android:textSize="36sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.028" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <Button
            android:id="@+id/buttonApplyAdvance"
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:layout_marginTop="1dp"
            android:text="Применить"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_body_size"
            android:singleLine="true"
            app:cornerRadius="20dp" />
        <ProgressBar
            android:id="@+id/applyProgressAdvance"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
