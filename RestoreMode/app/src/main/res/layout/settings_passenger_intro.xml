<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="29dp"
    android:paddingVertical="25dp"
    android:minHeight="126dp"
    android:background="@drawable/settings_intro">
    <ImageView
        android:layout_width="103dp"
        android:layout_height="76dp"
        android:src="@drawable/settings_overview_art"
        android:background="@android:color/transparent"
        android:importantForAccessibility="no"
        android:layout_marginEnd="30dp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пассажирский экран"
            android:textSize="26sp"
            android:textColor="#f3f5fa"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тот же набор виджетов, что на главном экране, со своими настройками, размерами и порядком. Открывается из «Все приложения» на пассажирском дисплее."
            android:textSize="18sp"
            android:textColor="#adbed5"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.45" />
    </LinearLayout>
</LinearLayout>
