<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/settings_sequence"
    android:padding="13dp"
    android:minHeight="76dp"
    android:layout_marginBottom="10dp">
    <TextView android:layout_width="26dp"
        android:layout_height="26dp"
        android:text="1"
        android:textSize="14sp"
        android:textColor="#b8d2f7"
        android:includeFontPadding="false"
        android:id="@+id/settingsSteerIndex"
        android:gravity="center"
        android:background="@drawable/settings_icon"
        android:layout_marginEnd="10dp" />
    <TextView android:id="@+id/steerActionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="4"
        android:lineSpacingMultiplier="1.45"
        android:textColor="@color/settings_text"
        android:textSize="17sp" />
    <LinearLayout android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp">
        <Button android:id="@+id/settingsSteerUp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="↑"
            android:contentDescription="Поднять действие"
            android:tag="settings.mini" />
        <Button android:id="@+id/settingsSteerDown"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="↓"
            android:contentDescription="Опустить действие"
            android:tag="settings.mini"
            android:layout_marginTop="4dp" />
    </LinearLayout>
    <ImageButton android:id="@+id/steerActionDelete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:background="@android:color/transparent"
        android:contentDescription="Удалить действие"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/settings_icon_trash" />
</LinearLayout>
