<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp"
    android:id="@+id/dockOverrideBlock">
    <ru.big.town.restoremode.settings.ui.layout.SettingsGrid
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:settingsColumns="2">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/settings_sequence">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="СЛОТ 1"
                android:textSize="13sp"
                android:textColor="#93aaca"
                android:includeFontPadding="false"
                android:letterSpacing="0.077" />
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@drawable/settings_icon_dock1"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Короткое нажатие"
                android:textSize="15sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginBottom="8dp" />
            <Button
                android:id="@+id/buttonDockApp1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Приложение 1: не выбрано"
                android:textColor="@color/settings_text"
                android:textSize="@dimen/settings_caption_size"
                android:singleLine="true"
                app:cornerRadius="20dp"
                android:tag="settings.field" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Долгое нажатие"
                android:textSize="15sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />
            <Button
                android:id="@+id/buttonDockSplit1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:text="Долгое нажатие: не назначено"
                android:textColor="@color/settings_muted"
                android:textSize="@dimen/settings_caption_size"
                android:singleLine="true"
                android:visibility="gone"
                app:cornerRadius="16dp"
                android:tag="settings.field" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Удерживайте поле приложения, чтобы сбросить слот"
                android:textSize="16sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginTop="18dp" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/settingsResetDock1"
                android:text="Сбросить слот"
                android:tag="settings.action"
                android:layout_marginTop="18dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/settings_sequence">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="СЛОТ 2"
                android:textSize="13sp"
                android:textColor="#93aaca"
                android:includeFontPadding="false"
                android:letterSpacing="0.077" />
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@drawable/settings_icon_dock2"
                android:background="@drawable/settings_icon"
                android:importantForAccessibility="no"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Короткое нажатие"
                android:textSize="15sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginBottom="8dp" />
            <Button
                android:id="@+id/buttonDockApp2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Приложение 2: не выбрано"
                android:textColor="@color/settings_text"
                android:textSize="@dimen/settings_caption_size"
                android:singleLine="true"
                app:cornerRadius="20dp"
                android:tag="settings.field" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Долгое нажатие"
                android:textSize="15sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />
            <Button
                android:id="@+id/buttonDockSplit2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:text="Долгое нажатие: не назначено"
                android:textColor="@color/settings_muted"
                android:textSize="@dimen/settings_caption_size"
                android:singleLine="true"
                android:visibility="gone"
                app:cornerRadius="16dp"
                android:tag="settings.field" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Удерживайте поле приложения, чтобы сбросить слот"
                android:textSize="16sp"
                android:textColor="#97a6bc"
                android:includeFontPadding="false"
                android:layout_marginTop="18dp" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/settingsResetDock2"
                android:text="Сбросить слот"
                android:tag="settings.action"
                android:layout_marginTop="18dp" />
        </LinearLayout>
    </ru.big.town.restoremode.settings.ui.layout.SettingsGrid>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Короткое нажатие возвращает приложение на экран нажатия и восстанавливает штатную медиакарточку. Долгое открывает сплит или приложение в медиакарточке приборной панели."
        android:textSize="17sp"
        android:textColor="#97a6bc"
        android:includeFontPadding="false"
        android:layout_marginTop="16dp" />
</LinearLayout>
