<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:layout_marginTop="14dp">
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/settingsEngineeringToggle"
        android:text="Инженерное меню    ＋"
        android:tag="settings.details"
        android:gravity="start|center_vertical" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/settingsEngineeringBody"
        android:visibility="gone"
        android:padding="24dp">
        <TextView
            android:id="@+id/textEngPasswordHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Пароль меняется каждые сутки в 00:00 по пекинскому времени — это 19:00 МСК, то есть вечером пароль уже «завтрашний». Считается от часов этой машины, поэтому если они врут — пароль не подойдёт."
            android:textColor="@color/settings_muted"
            android:textSize="@dimen/settings_caption_size" />
        <TextView
            android:id="@+id/textEngPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="—"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_heading_size" />
        <TextView
            android:id="@+id/textEngPasswordDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/settings_muted"
            android:textSize="@dimen/settings_caption_size" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Если дата машины неверна — пароль не подойдёт: сначала поправь дату. При вводе пароля в машине должен работать интернет.\n\nСтарые прошивки принимают постоянные пароли (с учётом регистра): HelloNewVoyah2022, hellovoyah, hellomotor, TBoxOff."
            android:textColor="@color/settings_muted"
            android:textSize="@dimen/settings_caption_size" />
    </LinearLayout>
</LinearLayout>
