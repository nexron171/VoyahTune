<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPedestrian"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_dark_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:onClick="onCardPedestrian"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Звук пешеходов" android:textColor="#FFFFFF" android:textSize="28px" android:textStyle="bold" />
    <TextView android:id="@+id/pedestrianBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/pill_inactive" android:text="не активно" android:textColor="#FFFFFF" android:textSize="18px" />
</LinearLayout>
