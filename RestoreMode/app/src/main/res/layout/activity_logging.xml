<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171C25"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBackLogging"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/nav_back_circle_bg"
                android:contentDescription="Назад"
                android:onClick="onButtonBackLogging"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/settings_arimo_bold"
                android:text="Логирование"
                android:textColor="#F3F5FA"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textLogStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/settings_arimo_regular"
            android:text="Подключаемся к службе записи логов…"
            android:textColor="#A5C8FF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textLogPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/settings_arimo_regular"
            android:text="Лимит файла — 15 МБ · последние 100 записей"
            android:textColor="#97A6BC"
            android:textSize="14sp" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="#12151C"
            android:padding="12dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#C8D0DA"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonStartLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:backgroundTint="#A5C8FF"
                android:fontFamily="@font/settings_arimo_bold"
                android:minHeight="64dp"
                android:text="Начать запись логов"
                android:textAllCaps="false"
                android:textColor="#172333"
                android:textSize="20sp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/buttonStopLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#384457"
                android:fontFamily="@font/settings_arimo_bold"
                android:minHeight="64dp"
                android:text="Остановить запись логов"
                android:textAllCaps="false"
                android:textColor="#F3F5FA"
                android:textSize="20sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonUploadLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:backgroundTint="#A5C8FF"
                android:fontFamily="@font/settings_arimo_bold"
                android:minHeight="64dp"
                android:text="Выгрузить запись логов на сервер"
                android:textAllCaps="false"
                android:textColor="#172333"
                android:textSize="20sp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/buttonDeleteLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#384457"
                android:fontFamily="@font/settings_arimo_bold"
                android:minHeight="64dp"
                android:text="Удалить файлы логов"
                android:textAllCaps="false"
                android:textColor="#FFB4BA"
                android:textSize="20sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
