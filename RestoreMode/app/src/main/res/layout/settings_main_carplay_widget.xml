<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/carplay_home_logo"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/carplay_home_title"
            android:textSize="22sp"
            android:textColor="@color/settings_text"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/carplay_widget_description"
        android:textSize="17sp"
        android:textColor="@color/settings_muted"
        android:lineSpacingMultiplier="1.45"
        android:includeFontPadding="false" />

    <Button
        android:id="@+id/buttonAddCarPlayShortcut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="60dp"
        android:text="@string/carplay_shortcut_add"
        android:textColor="@color/settings_text"
        android:textSize="@dimen/settings_body_size"
        android:tag="settings.add" />

    <Button
        android:id="@+id/buttonAddCarPlayWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="60dp"
        android:text="@string/carplay_widget_add"
        android:textColor="@color/settings_text"
        android:textSize="@dimen/settings_body_size"
        android:tag="settings.add" />
</LinearLayout>
