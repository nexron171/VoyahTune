<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/settings_card"
    android:padding="25dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="9dp"
            android:src="@drawable/settings_icon_suspension"
            android:background="@drawable/settings_icon"
            android:importantForAccessibility="no"
            android:layout_marginEnd="16dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Сервисный режим подвески"
            android:textSize="24sp"
            android:textColor="#f3f5fa"
            android:includeFontPadding="false"
            android:layout_weight="1" />
        <ru.big.town.restoremode.settings.ui.controls.SettingsToggle
            android:id="@+id/switchSuspensionMaintenance"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Целевое значение для сервисного режима подвески."
        android:textSize="17sp"
        android:textColor="#97a6bc"
        android:includeFontPadding="false" />
</LinearLayout>
