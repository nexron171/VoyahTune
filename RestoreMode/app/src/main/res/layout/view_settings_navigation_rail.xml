<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="20dp"
    android:gravity="top">
    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:padding="20dp"
        android:background="@drawable/settings_back"
        android:scaleType="fitCenter"
        android:src="@drawable/settings_icon_back"
        android:contentDescription="Назад" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:scrollbars="none"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/navMainScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Главный экран"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navDriveModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Настройки автомобиля"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navSplitScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Приложения и разделение экрана"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navApolloTech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Apollo Tech"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navSteeringButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Кнопки на руле"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navVoiceControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Голосовое управление"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navScenarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Сценарии"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Другое"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
            <TextView
                android:id="@+id/navCustomCommands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/nav_rail_item_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="Собственные команды"
                android:textColor="@color/settings_text"
                android:textSize="23sp"
                android:visibility="gone"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.18" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
